# One settings file for Docker Compose. Copy to .env or use the installer.
# After editing: docker compose up -d --force-recreate --wait
AB_PROJECT_NAME=agentic-browser
AB_MODE=authenticated
AB_PORT=3333
AB_BIND_ADDRESS=127.0.0.1
# AB_PUBLIC_URL=https://browser.example.com

# First startup on an empty authenticated workspace only. Choose your password.
# Existing accounts are never changed. Ignored in public mode.
AB_ADMIN_USERNAME=admin
AB_ADMIN_PASSWORD=

AB_MAX_SESSIONS=1
AB_MAX_SESSIONS_PER_MEMBER=1
AB_SESSION_TTL_SECONDS=1800
AB_SESSION_MAX_LIFETIME_SECONDS=14400

# Public mode only: anonymous temporary sessions (5 minutes, 10 minutes maximum).
AB_MAX_SESSIONS_PER_IP=2
# Enable only behind a trusted proxy which overwrites X-Real-IP.
AB_TRUST_PROXY=false
# AB_EGRESS_DENY_HOSTS=other-management.example.com
# AB_RUNTIME_PLATFORM=auto

# The installer adds AB_DOCKER_SOCKET and AB_DOCKER_GID for your Docker host.
