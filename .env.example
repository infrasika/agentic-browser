AGENT_BROWSER_TOKEN=replace-with-a-random-token-at-least-32-characters
HOST=127.0.0.1
PORT=3333
PUBLIC_URL=http://127.0.0.1:3333
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=4
# Linux native desktop: install dependencies with npm run desktop:install
BROWSER_MODE=playwright
# BROWSER_MODE=desktop
# DESKTOP_CHROME_PATH=/usr/bin/google-chrome-stable
# CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
# HEADLESS=false
# Opt-in saved login profiles (keep this private and outside version control)
BROWSER_DATA_DIR=.data

# Team self-hosting: set BROWSER_AUTH_MODE=team and BROWSER_MODE=docker.
# Public demonstration: set BROWSER_AUTH_MODE=demo and BROWSER_MODE=docker.
# Demo forces offline temporary containers, 1 session/guest and a 10-minute lifetime.
# Create members locally with npm run members -- create alice
# In team mode the shared AGENT_BROWSER_TOKEN is ignored.
BROWSER_AUTH_MODE=legacy
# BROWSER_RUNTIME_IMAGE=agentic-browser:zkpass-prototype
# BROWSER_NETWORK=public
# BROWSER_EGRESS_DENY_HOSTS=other-management.example.com
# Container-controller prototype: existing Docker named volume mounted at /data.
# BROWSER_DATA_VOLUME=agentic-browser-desktop-data
# BROWSER_DATA_VOLUME_ROOT=/data
MAX_SESSIONS_PER_MEMBER=2
SESSION_MAX_LIFETIME_SECONDS=14400
