# Copy to .env.public. These settings do not load the existing .env/.env.compose.
AB_PROJECT_NAME=agentic-browser-demo
AB_PORT=3334
AB_BIND_ADDRESS=127.0.0.1
AB_PUBLIC_URL=http://127.0.0.1:3334
AB_MAX_SESSIONS=2
AB_MAX_SESSIONS_PER_IP=2
# IP-only test: set AB_BIND_ADDRESS=0.0.0.0 and AB_PUBLIC_URL=http://SERVER_IP:3334.
# HTTPS: keep bind=127.0.0.1, set the https origin and install the proxy template.
# Only enable behind a trusted proxy which overwrites X-Real-IP.
AB_TRUST_PROXY=false
# Also deny any public IP/hostname exposing this host's other management services.
# AB_EGRESS_DENY_HOSTS=management.example.com,203.0.113.10
