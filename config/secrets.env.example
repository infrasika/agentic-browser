# Copy to secrets.env. Never commit or share this file.
# Read as a file inside the initializer; Docker Compose does not interpolate values.
QWEN_API_KEY=CHANGE_ME_BEFORE_START
DEMO_ADMIN_PASSWORD=CHANGE_ME_BEFORE_START
# Optional: set together with settings.json turnstileSiteKey / smtp.username.
TURNSTILE_SECRET_KEY=
SMTP_PASSWORD=
# Application encryption keys and the browser token are generated in a persistent volume.
