# Public reference only. Keep all values in this committed file empty.
# Run agentctl init --config-directory /absolute/path/to/config/local,
# then edit secrets.env in that private configuration directory.
# Do not copy this file over the generated secrets: init creates unique keys.
# See docs/CONFIGURATION.md in source, or CONFIGURATION.md in the bundle.

# REQUIRED: your Qwen API key; model name, base URL and rates go in settings.json.
QWEN_API_KEY=

# GENERATED: init creates a random administrator password (minimum 12 characters).
# You may change it before first startup. Use user-reset for existing accounts.
DEMO_ADMIN_PASSWORD=

# GENERATED: keep the unique values created by init across restarts and upgrades.
# JWT_SECRET / JWT_REFRESH_SECRET / CREDS_KEY: 64 hexadecimal characters each.
# CREDS_IV: 32 hexadecimal characters. Do not reuse keys from another site.
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# CONDITIONAL: pair with settings.turnstileSiteKey; required for public signup.
TURNSTILE_SECRET_KEY=

# OPTIONAL: required when settings.smtp.username is set.
# For Cloudflare SMTP, put the Email Sending API token here.
SMTP_PASSWORD=

# browser-token is a separate file generated by init, not an env variable.
# Cloudflare Origin CA private keys belong to host Nginx, not this file.
