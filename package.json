{
  "name": "agentic-browser",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:service": "tsx --test test/browser-session.test.ts test/browser-service.test.ts",
    "dev": "tsx watch src/service.ts",
    "start": "tsx src/service.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "runtime:fetch": "python3 scripts/build/fetch-runtime-assets.py",
    "runtime:build": "npm run runtime:fetch && docker build -f runtime/Dockerfile -t agentic-browser-runtime:development .",
    "test:extensions": "bash test/acceptance/test-extensions.sh",
    "test:runtime": "tsx --test test/runtime.integration.ts",
    "build:agent": "python3 scripts/build/build-agent-images.py --run",
    "test:agent-config": "node --test test/agent-deployment.test.mjs",
    "accept:agent": "node test/acceptance/accept-agent-compose.mjs --run",
    "agent": "python3 deploy/agent/agentctl.py",
    "test:agent-ops": "python3 -m unittest discover -s test -p test_agent_operations.py",
    "accept:agent-ops": "node test/acceptance/accept-agent-operations.mjs --run",
    "package:agent": "python3 scripts/build/package-agent.py",
    "test:agent-bundle": "python3 -m unittest discover -s test -p test_agent_bundle.py",
    "test:python": "python3 -m unittest discover -s test -p \"test_*.py\""
  },
  "dependencies": {
    "playwright": "1.64.0",
    "tsx": "4.21.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
