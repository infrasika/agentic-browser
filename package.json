{
  "name": "agentic-browser",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:librechat": "node scripts/librechat-config.mjs setup",
    "doctor:librechat": "node scripts/librechat-config.mjs check",
    "mail:test:librechat": "node scripts/librechat-mail.mjs test",
    "health:librechat": "tsx scripts/check-librechat-health.ts",
    "backup:librechat": "python3 scripts/backup-librechat.py",
    "verify:librechat-backup": "tsx scripts/verify-librechat-backup.ts",
    "verify:librechat-recovery": "python3 scripts/verify-librechat-recovery.py",
    "start:service": "tsx src/service.ts",
    "test:service": "tsx --test test/browser-service.test.ts test/librechat-config.test.ts",
    "setup": "node scripts/setup.mjs",
    "predev": "npm run package:self-host",
    "dev": "tsx watch src/main.ts",
    "prestart": "npm run package:self-host",
    "start": "tsx src/main.ts",
    "mcp": "tsx src/mcp.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "tsx --test test/browser.integration.ts",
    "test:desktop": "tsx --test test/desktop.integration.ts test/persistence.integration.ts",
    "browser:install": "playwright install chromium",
    "desktop:install": "bash scripts/install-desktop.sh",
    "runtime:fetch": "python3 scripts/fetch-runtime-assets.py",
    "runtime:build": "npm run runtime:fetch && docker build -f runtime/Dockerfile -t agentic-browser:zkpass-prototype .",
    "test:extensions": "bash scripts/test-extensions.sh",
    "members": "tsx src/members-cli.ts",
    "test:team": "tsx --test test/team-browser.integration.ts test/team-desktop.integration.ts",
    "test:runtime": "tsx --test test/runtime.integration.ts",
    "test:controller": "tsx --test test/controller.integration.ts",
    "test:demo": "tsx --test test/public-demo.integration.ts",
    "test:public-mcp": "tsx --test test/public-mcp.integration.ts",
    "test:reliability": "tsx --test test/reliability.integration.ts",
    "test:soak": "node scripts/soak.mjs",
    "test:self-host": "tsx --test test/self-host.integration.ts",
    "test:experience": "node scripts/experience.mjs",
    "test:remote-client": "node scripts/remote-client.mjs",
    "test:https": "node scripts/https.mjs",
    "test:upgrade": "tsx --test test/upgrade.integration.ts",
    "doctor": "tsx src/doctor.ts",
    "package:self-host": "python3 scripts/package-self-host.py",
    "verify": "bash scripts/acceptance.sh",
    "build:agent": "python3 scripts/build-agent-images.py --run",
    "test:agent-config": "node --test test/agent-deployment.test.mjs",
    "accept:agent": "node scripts/accept-agent-compose.mjs --run",
    "agent": "python3 deploy/agent/agentctl.py",
    "test:agent-ops": "python3 -m unittest discover -s test -p test_agent_operations.py",
    "accept:agent-ops": "node scripts/accept-agent-operations.mjs --run",
    "package:agent": "python3 scripts/package-agent.py",
    "test:agent-bundle": "python3 -m unittest discover -s test -p test_agent_bundle.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@novnc/novnc": "1.7.0",
    "playwright": "1.64.0",
    "tsx": "4.21.0",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
