new file mode 100644
index 0000000000000000000000000000000000000000..8fa22116db51f5e87be0075761ded61943e4691e
--- /dev/null
+++ b/packages/api/src/browser/bootstrap.ts
@@ -0,0 +1,158 @@
+import { z } from 'zod';
+import { AccessRoleIds, PrincipalType, ResourceType, SystemRoles } from 'librechat-data-provider';
+import type { UserRecord } from '@librechat/data-schemas';
+
+type AgentRecord = {
+  _id: { toString(): string };
+  id: string;
+  author: { toString(): string };
+  model: string;
+  name?: string;
+  description?: string;
+  instructions?: string;
+  conversation_starters?: string[];
+};
+interface BootstrapDependencies {
+  findUser: (filter: { email: string }, projection: string) => Promise<UserRecord | null>;
+  countUsers: () => Promise<number>;
+  registerUser: (
+    input: Record<string, string>,
+    trusted: { emailVerified: boolean },
+  ) => Promise<{ status: number }>;
+  getAgent: (filter: { id: string }) => Promise<AgentRecord | null>;
+  createAgent: (input: Record<string, unknown>) => Promise<AgentRecord>;
+  updateAgent: (
+    filter: { id: string; author: string },
+    update: Record<string, unknown>,
+    options: { updatingUserId: string },
+  ) => Promise<AgentRecord | null>;
+  grantPermission: (input: {
+    principalType: PrincipalType;
+    principalId: string | null;
+    resourceType: ResourceType;
+    resourceId: string;
+    accessRoleId: AccessRoleIds;
+    grantedBy: string;
+  }) => Promise<unknown>;
+}
+interface BrowserDemoInput {
+  email: string;
+  password: string;
+  model: string;
+  agentId: string;
+  provider: string;
+  administratorName?: string;
+  administratorUsername?: string;
+  definition: {
+    name: string;
+    description: string;
+    instructions: string;
+    conversation_starters: string[];
+  };
+}
+const definitionSchema = z
+  .object({
+    name: z.string().min(1).max(100),
+    description: z.string().min(1).max(2000),
+    instructions: z.string().min(1).max(20000),
+    conversation_starters: z.array(z.string().min(1).max(1000)).min(1).max(8),
+  })
+  .strict();
+const inputSchema = z.object({
+  email: z.string().email(),
+  password: z.string().min(12),
+  model: z.string().min(1),
+  agentId: z.string().min(1),
+  provider: z.string().min(1),
+  administratorName: z.string().min(1).max(100).default('Demo Administrator'),
+  administratorUsername: z
+    .string()
+    .regex(/^[a-zA-Z0-9_-]{3,40}$/)
+    .default('demo-admin'),
+  definition: definitionSchema,
+});
+
+/** Run offline before public registration opens. Re-running never resets passwords or credits. */
+export async function bootstrapBrowserDemo(
+  input: BrowserDemoInput,
+  deps: BootstrapDependencies,
+): Promise<{ ready: boolean; agentId: string }> {
+  const config = inputSchema.parse(input);
+  const email = config.email.trim().toLowerCase();
+  let admin = await deps.findUser({ email }, '_id email role');
+  if (!admin) {
+    if ((await deps.countUsers()) !== 0)
+      throw new Error('Bootstrap requires the configured administrator or an empty database');
+    const created = await deps.registerUser(
+      {
+        email,
+        password: config.password,
+        confirm_password: config.password,
+        name: config.administratorName,
+        username: config.administratorUsername,
+      },
+      { emailVerified: true },
+    );
+    if (created.status !== 200) throw new Error('Administrator bootstrap failed');
+    admin = await deps.findUser({ email }, '_id email role');
+  }
+  if (!admin || admin.role !== SystemRoles.ADMIN)
+    throw new Error('Configured account is not an administrator');
+  const adminId = admin._id.toString();
+  let agent = await deps.getAgent({ id: config.agentId });
+  if (!agent)
+    agent = await deps.createAgent({
+      id: config.agentId,
+      ...config.definition,
+      provider: config.provider,
+      model: config.model,
+      author: adminId,
+      tools: [],
+      actions: [],
+      skills_enabled: false,
+      model_parameters: {
+        model: config.model,
+        temperature: 0.2,
+        max_tokens: 2048,
+        maxContextTokens: 64000,
+      },
+      recursion_limit: 40,
+    });
+  if (agent.author.toString() !== adminId || agent.model !== config.model)
+    throw new Error('Existing demo agent differs from the deployment configuration');
+  // This deployment owns only presentation and task guidance. Preserve model, tools, ACLs,
+  // credentials, and account balances; avoid creating a version on every process restart.
+  const currentAgent = agent;
+  const changed = Object.entries(config.definition).some(
+    ([key, value]) =>
+      JSON.stringify(currentAgent[key as keyof AgentRecord]) !== JSON.stringify(value),
+  );
+  if (changed) {
+    const updated = await deps.updateAgent(
+      { id: config.agentId, author: adminId },
+      config.definition,
+      { updatingUserId: adminId },
+    );
+    if (!updated) throw new Error('Demo definition update failed');
+    agent = updated;
+  }
+  await Promise.all([
+    deps.grantPermission({
+      principalType: PrincipalType.USER,
+      principalId: adminId,
+      resourceType: ResourceType.AGENT,
+      resourceId: agent._id.toString(),
+      accessRoleId: AccessRoleIds.AGENT_OWNER,
+      grantedBy: adminId,
+    }),
+    deps.grantPermission({
+      principalType: PrincipalType.PUBLIC,
+      principalId: null,
+      resourceType: ResourceType.AGENT,
+      resourceId: agent._id.toString(),
+      accessRoleId: AccessRoleIds.AGENT_VIEWER,
+      grantedBy: adminId,
+    }),
+  ]);
+  return { ready: true, agentId: agent.id };
+}
diff --git a/packages/api/src/browser/client.ts b/packages/api/src/browser/client.ts
new file mode 100644
index 0000000000000000000000000000000000000000..83a569329028f6d6762a4cce0a7c369a2801c9c3
--- /dev/null
+++ b/packages/api/src/browser/client.ts
@@ -0,0 +1,196 @@
+import { z } from 'zod';
+import {
+  browserLeaseSchema,
+  browserGrantSchema,
+  browserEventSchema,
+} from 'librechat-data-provider';
+import type {
+  BrowserConfig,
+  BrowserPrincipal,
+  BrowserLease,
+  ResourceEvent,
+} from 'librechat-data-provider';
+
+export type BrowserResult<T> =
+  | { ok: true; value: T }
+  | { ok: false; error: { code: string; status: number } };
+export type BrowserTransport = (
+  input: string | URL | Request,
+  init?: RequestInit,
+) => Promise<Response>;
+const errorSchema = z.object({ error: z.string().regex(/^[a-z_]{1,64}$/) });
+const pathFor = (id: string) =>
+  `/internal/v1/leases/${encodeURIComponent(z.string().uuid().parse(id))}`;
+
+/** Only server-injected principals and service credentials enter this transport. */
+export class BrowserClient {
+  constructor(
+    private config: BrowserConfig,
+    private token: string,
+    private transport: BrowserTransport,
+  ) {
+    const url = new URL(config.baseURL);
+    if (
+      !['http:', 'https:'].includes(url.protocol) ||
+      url.username ||
+      url.password ||
+      url.search ||
+      url.hash
+    ) {
+      throw new Error('Invalid private browser endpoint');
+    }
+    if (token.length < 32) throw new Error('Browser service credential is missing');
+  }
+
+  async request<T>(
+    path: string,
+    schema: z.ZodType<T>,
+    options: {
+      method?: string;
+      body?: unknown;
+      principal?: BrowserPrincipal;
+      actor?: 'agent' | 'human';
+      signal?: AbortSignal;
+    } = {},
+  ): Promise<BrowserResult<T>> {
+    const timeout = AbortSignal.timeout(this.config.requestTimeoutMs);
+    const principal = options.principal;
+    const response = await this.transport(new URL(path, this.config.baseURL), {
+      method: options.method ?? 'GET',
+      redirect: 'error',
+      headers: {
+        authorization: `Bearer ${this.token}`,
+        'content-type': 'application/json',
+        ...(principal
+          ? {
+              'x-user-id': principal.userId,
+              'x-conversation-id': principal.conversationId,
+              'x-task-id': principal.taskId,
+              'x-actor': options.actor ?? 'agent',
+            }
+          : {}),
+      },
+      ...(options.body !== undefined ? { body: JSON.stringify(options.body) } : {}),
+      signal: options.signal ? AbortSignal.any([timeout, options.signal]) : timeout,
+    }).catch(() => {
+      throw new Error('Browser transport unavailable');
+    });
+    const body: unknown = await response.json().catch(() => {
+      throw new Error('Invalid Browser response');
+    });
+    if (!response.ok) {
+      const parsed = errorSchema.safeParse(body);
+      return {
+        ok: false,
+        error: {
+          code: parsed.success ? parsed.data.error : 'browser_unavailable',
+          status: response.status,
+        },
+      };
+    }
+    const parsed = schema.safeParse(body);
+    if (!parsed.success) throw new Error('Invalid Browser response');
+    return { ok: true, value: parsed.data };
+  }
+
+  task(
+    principal: BrowserPrincipal,
+    signal?: AbortSignal,
+  ): Promise<BrowserResult<{ lease: BrowserLease | null }>> {
+    return this.request('/internal/v1/task', z.object({ lease: browserLeaseSchema.nullable() }), {
+      principal,
+      signal,
+    });
+  }
+
+  lease(
+    id: string,
+    principal: BrowserPrincipal,
+    signal?: AbortSignal,
+  ): Promise<BrowserResult<BrowserLease>> {
+    return this.request(pathFor(id), browserLeaseSchema, { principal, signal });
+  }
+
+  acquire(
+    principal: BrowserPrincipal,
+    body: { acquisitionId: string; purpose: string; url: string },
+    signal?: AbortSignal,
+  ): Promise<BrowserResult<BrowserLease>> {
+    return this.request('/internal/v1/leases', browserLeaseSchema, {
+      method: 'POST',
+      principal,
+      body,
+      signal,
+    });
+  }
+
+  command(
+    id: string,
+    operation: 'actions' | 'snapshot' | 'control',
+    principal: BrowserPrincipal,
+    body: unknown,
+    signal?: AbortSignal,
+    actor: 'agent' | 'human' = 'agent',
+  ): Promise<BrowserResult<unknown>> {
+    return this.request(`${pathFor(id)}/${operation}`, z.unknown(), {
+      method: 'POST',
+      principal,
+      body,
+      signal,
+      actor,
+    });
+  }
+
+  grant(
+    id: string,
+    principal: BrowserPrincipal,
+    revision: number,
+    role: 'observe' | 'input',
+  ): Promise<BrowserResult<z.infer<typeof browserGrantSchema>>> {
+    return this.request(`${pathFor(id)}/viewer-grants`, browserGrantSchema, {
+      method: 'POST',
+      principal,
+      actor: 'human',
+      body: { revision, role },
+    });
+  }
+
+  release(
+    id: string,
+    principal: BrowserPrincipal,
+    outcome: 'completed' | 'cancelled' = 'cancelled',
+  ): Promise<BrowserResult<BrowserLease>> {
+    return this.request(pathFor(id), browserLeaseSchema, {
+      method: 'DELETE',
+      principal,
+      body: { outcome },
+    });
+  }
+
+  revokeUser(userId: string): Promise<BrowserResult<{ revoked: boolean }>> {
+    return this.request('/internal/v1/revoke', z.object({ revoked: z.boolean() }), {
+      method: 'POST',
+      principal: { userId, conversationId: 'logout', taskId: 'logout' },
+      body: {},
+      actor: 'human',
+    });
+  }
+
+  leases(): Promise<BrowserResult<{ leases: BrowserLease[] }>> {
+    return this.request('/internal/v1/leases', z.object({ leases: z.array(browserLeaseSchema) }));
+  }
+
+  events(): Promise<BrowserResult<{ events: ResourceEvent[]; cursor: number }>> {
+    return this.request(
+      '/internal/v1/events',
+      z.object({ events: z.array(browserEventSchema), cursor: z.number() }),
+    );
+  }
+
+  ack(cursor: number): Promise<BrowserResult<{ cursor: number }>> {
+    return this.request('/internal/v1/events/ack', z.object({ cursor: z.number() }), {
+      method: 'POST',
+      body: { cursor },
+    });
+  }
+}
