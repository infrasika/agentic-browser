diff --git a/packages/data-schemas/src/models/siteBudget.ts b/packages/data-schemas/src/models/siteBudget.ts
new file mode 100644
index 0000000000000000000000000000000000000000..78deb7825490b658bbf2be2bd084a545eb61dbae
--- /dev/null
+++ b/packages/data-schemas/src/models/siteBudget.ts
@@ -0,0 +1,35 @@
+import { Schema } from 'mongoose';
+import type { Model } from 'mongoose';
+
+export interface BudgetDay {
+  spent: number;
+  reserved: number;
+  uncertain: number;
+  holds: { id: string; credits: number }[];
+}
+
+export interface SiteBudgetRecord {
+  _id: string;
+  limitCredits: number;
+  revision: number;
+  days: Record<string, BudgetDay>;
+  changes: { actor: string; limitCredits: number; at: Date }[];
+}
+
+const schema = new Schema<SiteBudgetRecord>(
+  {
+    _id: { type: String, required: true },
+    limitCredits: { type: Number, required: true },
+    revision: { type: Number, default: 0 },
+    days: { type: Schema.Types.Mixed, default: {} },
+    changes: { type: [{ _id: false, actor: String, limitCredits: Number, at: Date }], default: [] },
+  },
+  { minimize: false },
+);
+
+/** Deployment-wide budget, intentionally independent of the current user's tenant. */
+export function createSiteBudgetModel(
+  mongoose: typeof import('mongoose'),
+): Model<SiteBudgetRecord> {
+  return mongoose.models.SiteBudget || mongoose.model<SiteBudgetRecord>('SiteBudget', schema);
+}
