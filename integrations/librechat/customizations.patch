@@ -0,0 +1,33 @@
+import { lazy, Suspense } from 'react';
+import { browserConfigSchema } from 'librechat-data-provider';
+import type { ReactNode } from 'react';
+import { useGetStartupConfig } from '~/data-provider';
+const BrowserPanel = lazy(() => import('./Panel'));
+
+export default function BrowserLayout({
+  children,
+  agentId,
+  conversationId,
+}: {
+  children: ReactNode;
+  agentId?: string | null;
+  conversationId?: string;
+}) {
+  const { data: config } = useGetStartupConfig();
+  if (!agentId || !config?.browser?.agentIds.includes(agentId)) return <>{children}</>;
+  return (
+    <div className="grid h-full min-h-0 min-w-0 grid-cols-1 overflow-auto lg:grid-cols-2 lg:overflow-hidden">
+      <div className="flex min-h-0 min-w-0 flex-col overflow-hidden">{children}</div>
+      <Suspense fallback={<div role="status" aria-busy="true" className="min-h-80" />}>
+        <BrowserPanel
+          conversationId={conversationId}
+          pollIntervalMs={config.browser.pollIntervalMs}
+          viewerConnectTimeoutMs={
+            config.browser.viewerConnectTimeoutMs ??
+            browserConfigSchema.shape.viewerConnectTimeoutMs.parse(undefined)
+          }
+        />
+      </Suspense>
+    </div>
+  );
+}
diff --git a/client/src/components/Chat/Browser/Panel.tsx b/client/src/components/Chat/Browser/Panel.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..97fdd63bd8a10f59a75691801af8e15f81d3d5d1
--- /dev/null
+++ b/client/src/components/Chat/Browser/Panel.tsx
@@ -0,0 +1,107 @@
+import { useCallback } from 'react';
+import { Button } from '@librechat/client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { browserDataService, QueryKeys, MutationKeys } from 'librechat-data-provider';
+import { useLocalize } from '~/hooks';
+import Screen from './Screen';
+
+export default function BrowserPanel({
+  conversationId,
+  pollIntervalMs,
+  viewerConnectTimeoutMs,
+}: {
+  conversationId?: string;
+  pollIntervalMs: number;
+  viewerConnectTimeoutMs: number;
+}) {
+  const localize = useLocalize();
+  const cache = useQueryClient();
+  const usable = !!conversationId && /^[0-9a-f-]{36}$/.test(conversationId);
+  const key = [QueryKeys.browser, conversationId];
+  const query = useQuery(key, () => browserDataService.status(conversationId!), {
+    enabled: usable,
+    refetchInterval: pollIntervalMs,
+    retry: false,
+    refetchOnWindowFocus: true,
+  });
+  const lease = query.data?.lease;
+  const refresh = useCallback(() => {
+    void cache.invalidateQueries([QueryKeys.browser, conversationId]);
+  }, [cache, conversationId]);
+  const mutation = useMutation({
+    mutationKey: [MutationKeys.browser, conversationId],
+    mutationFn: (action: 'agent' | 'human' | 'cancel') => {
+      if (!conversationId || !lease) throw new Error('No browser session');
+      return action === 'cancel'
+        ? browserDataService.cancel(conversationId)
+        : browserDataService.control(conversationId, lease.revision, action, crypto.randomUUID());
+    },
+    onSettled: () => cache.invalidateQueries(key),
+  });
+  const pendingControl =
+    mutation.isLoading && mutation.variables !== 'cancel' ? mutation.variables : undefined;
+  const active = lease?.state === 'active';
+  const queued = lease?.state === 'queued' || lease?.state === 'starting';
+  let statusText = localize('com_browser_idle');
+  if (active)
+    statusText = localize(lease.control === 'human' ? 'com_browser_human' : 'com_browser_agent');
+  if (pendingControl) statusText = localize('com_browser_switching');
+  if (queued) statusText = localize('com_browser_queue', { position: lease?.position ?? '…' });
+  if (query.isFetching && !query.data) statusText = localize('com_browser_loading');
+  return (
+    <aside
+      aria-label={localize('com_browser_title')}
+      className="border-border-light bg-surface-primary text-text-primary flex min-h-80 min-w-0 flex-col gap-3 p-3 lg:border-l"
+    >
+      <h2 className="text-lg font-semibold">{localize('com_browser_title')}</h2>
+      <div role="status" aria-live="polite" className="text-text-secondary text-sm">
+        {statusText}
+      </div>
+      {active && !query.isError && (
+        <Screen
+          key={`${conversationId}:${lease.id}`}
+          conversationId={conversationId!}
+          lease={lease}
+          pendingControl={pendingControl}
+          connectTimeoutMs={viewerConnectTimeoutMs}
+          onAccessChanged={refresh}
+        />
+      )}
+      {query.isError && (
+        <div role="alert" className="text-sm">
+          {localize('com_browser_status_error')}
+          <Button variant="outline" onClick={() => query.refetch()}>
+            {localize('com_browser_reconnect')}
+          </Button>
+        </div>
+      )}
+      {mutation.isError && (
+        <p role="alert" className="text-sm">
+          {localize('com_browser_action_error')}
+        </p>
+      )}
+      {(active || queued) && (
+        <div className="flex flex-wrap gap-2">
+          {active && (
+            <Button
+              disabled={mutation.isLoading}
+              onClick={() => mutation.mutate(lease.control === 'human' ? 'agent' : 'human')}
+            >
+              {localize(lease.control === 'human' ? 'com_browser_return' : 'com_browser_takeover')}
+            </Button>
+          )}
+          <Button
+            variant="outline"
+            disabled={mutation.isLoading}
+            onClick={() => mutation.mutate('cancel')}
+          >
+            {localize('com_browser_cancel')}
+          </Button>
+        </div>
+      )}
+      {active && lease.control === 'human' && (
+        <p className="text-text-secondary text-sm">{localize('com_browser_privacy')}</p>
+      )}
+    </aside>
+  );
+}
diff --git a/client/src/components/Chat/Browser/Screen.tsx b/client/src/components/Chat/Browser/Screen.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..74995b75aa23056404fc7c4601ad139ab5aebd78
--- /dev/null
+++ b/client/src/components/Chat/Browser/Screen.tsx
@@ -0,0 +1,262 @@
+import { useCallback, useLayoutEffect, useRef, useState } from 'react';
+import RFB from '@novnc/novnc';
+import { Button, Spinner } from '@librechat/client';
+import { browserDataService } from 'librechat-data-provider';
+import type { BrowserLease } from 'librechat-data-provider';
+import { useLocalize } from '~/hooks';
+
+export default function Screen({
+  conversationId,
+  lease,
+  pendingControl,
+  connectTimeoutMs,
+  onAccessChanged,
+}: {
+  conversationId: string;
+  lease: BrowserLease;
+  pendingControl?: 'human' | 'agent';
+  connectTimeoutMs: number;
+  onAccessChanged: () => void;
+}) {
+  const localize = useLocalize();
+  const target = useRef<HTMLDivElement>(null);
+  const picture = useRef<HTMLImageElement>(null);
+  const preview = useRef<HTMLCanvasElement>(null);
+  const desktopRef = useRef<RFB>();
+  const readyRole = useRef<'input' | 'observe'>();
+  const frozenRef = useRef(false);
+  const pendingRef = useRef(pendingControl);
+  const refreshRef = useRef(onAccessChanged);
+  const timer = useRef<ReturnType<typeof setTimeout>>();
+  const [failed, setFailed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  const [connected, setConnected] = useState(false);
+  const [frozen, setFrozen] = useState(false);
+  const [switching, setSwitching] = useState(false);
+  const role = lease.control === 'human' ? 'input' : 'observe';
+
+  const clearPreview = useCallback(() => {
+    if (preview.current) preview.current.width = preview.current.height = 0;
+    frozenRef.current = false;
+    setFrozen(false);
+  }, []);
+  const freeze = useCallback(() => {
+    if (frozenRef.current || !readyRole.current || !preview.current) return;
+    const source =
+      readyRole.current === 'input' ? target.current?.querySelector('canvas') : picture.current;
+    if (!source) return;
+    const width = source instanceof HTMLImageElement ? source.naturalWidth : source.width;
+    const height = source instanceof HTMLImageElement ? source.naturalHeight : source.height;
+    if (!width || !height) return;
+    try {
+      const context = preview.current.getContext('2d');
+      if (!context) return;
+      preview.current.width = width;
+      preview.current.height = height;
+      context.drawImage(source, 0, 0);
+      frozenRef.current = true;
+      setFrozen(true);
+    } catch {
+      // A missing/undecodable frame must not prevent a control transfer.
+      clearPreview();
+    }
+  }, [clearPreview]);
+  const watchConnection = useCallback(() => {
+    clearTimeout(timer.current);
+    timer.current = setTimeout(() => setFailed(true), connectTimeoutMs);
+  }, [connectTimeoutMs]);
+
+  useLayoutEffect(() => {
+    pendingRef.current = pendingControl;
+    refreshRef.current = onAccessChanged;
+  }, [pendingControl, onAccessChanged]);
+
+  useLayoutEffect(() => {
+    let disposed = false;
+    let socket: WebSocket | undefined;
+    let desktop: RFB | undefined;
+    let frame: string | undefined;
+    let decoding: HTMLImageElement | undefined;
+    let accessChanged = false;
+    setFailed(false);
+    setConnected(false);
+    watchConnection();
+    const fail = () => {
+      if (disposed || accessChanged) return;
+      clearTimeout(timer.current);
+      setFailed(true);
+    };
+    const ready = () => {
+      if (disposed || accessChanged) return;
+      readyRole.current = role;
+      setConnected(true);
+      setFailed(false);
+      setSwitching(false);
+      if (!pendingRef.current) {
+        clearTimeout(timer.current);
+        clearPreview();
+      }
+    };
+    void browserDataService
+      .viewer(conversationId, lease.revision, role)
+      .then((grant) => {
+        if (disposed) return;
+        const url = new URL(grant.path, location.origin);
+        if (url.origin !== location.origin || !url.pathname.startsWith('/browser/v1/'))
+          throw new Error('Invalid viewer endpoint');
+        url.protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
+        socket = new WebSocket(url);
+        socket.binaryType = 'arraybuffer';
+        // noVNC owns the onclose/onerror properties. Independent listeners also run
+        // before noVNC removes its canvas, so the final frame can be retained locally.
+        socket.addEventListener('close', (event) => {
+          if (disposed) return;
+          if (event.code === 1008 && event.reason === 'Browser access changed') {
+            accessChanged = true;
+            freeze();
+            readyRole.current = undefined;
+            setConnected(false);
+            setSwitching(true);
+            watchConnection();
+            refreshRef.current();
+          } else {
+            fail();
+          }
+        });
+        socket.addEventListener('error', fail);
+        socket.onopen = () => {
+          if (disposed || !socket) return;
+          socket.send(JSON.stringify({ grant: grant.grant }));
+          if (role === 'input' && target.current) {
+            desktop = new RFB(target.current, socket);
+            desktopRef.current = desktop;
+            desktop.scaleViewport = true;
+            desktop.resizeSession = false;
+            desktop.viewOnly = !!pendingRef.current;
+            desktop.addEventListener('connect', ready);
+            desktop.addEventListener('disconnect', () => {
+              // Socket closure is classified by its close code above. An RFB
+              // protocol failure with an open transport is a genuine failure.
+              if (!accessChanged && socket?.readyState === WebSocket.OPEN) fail();
+            });
+          }
+        };
+        if (role === 'observe') {
+          socket.onmessage = (event: MessageEvent<ArrayBuffer>) => {
+            if (disposed || accessChanged || decoding || !(event.data instanceof ArrayBuffer))
+              return;
+            const next = URL.createObjectURL(new Blob([event.data], { type: 'image/jpeg' }));
+            const image = new Image();
+            decoding = image;
+            image.onload = () => {
+              if (disposed || accessChanged) return;
+              if (picture.current) picture.current.src = next;
+              if (frame) URL.revokeObjectURL(frame);
+              frame = next;
+              decoding = undefined;
+              ready();
+            };
+            image.onerror = () => {
+              URL.revokeObjectURL(next);
+              decoding = undefined;
+              fail();
+            };
+            image.src = next;
+          };
+        }
+      })
+      .catch(fail);
+    return () => {
+      freeze();
+      readyRole.current = undefined;
+      disposed = true;
+      clearTimeout(timer.current);
+      desktopRef.current = undefined;
+      desktop?.disconnect();
+      socket?.close();
+      if (decoding) {
+        decoding.onload = decoding.onerror = null;
+        URL.revokeObjectURL(decoding.src);
+      }
+      if (frame) URL.revokeObjectURL(frame);
+    };
+  }, [
+    conversationId,
+    lease.id,
+    lease.revision,
+    role,
+    attempt,
+    watchConnection,
+    freeze,
+    clearPreview,
+  ]);
+
+  useLayoutEffect(() => {
+    if (desktopRef.current) desktopRef.current.viewOnly = !!pendingControl;
+    if (pendingControl) {
+      freeze();
+      watchConnection();
+    } else if (readyRole.current) {
+      clearTimeout(timer.current);
+      clearPreview();
+    }
+  }, [pendingControl, freeze, watchConnection, clearPreview]);
+
+  const busy = !failed && (!connected || !!pendingControl || switching);
+  let label:
+    | 'com_browser_connecting'
+    | 'com_browser_updating'
+    | 'com_browser_returning'
+    | 'com_browser_preparing' =
+    switching || frozen ? 'com_browser_updating' : 'com_browser_connecting';
+  if (pendingControl) {
+    label = pendingControl === 'agent' ? 'com_browser_returning' : 'com_browser_preparing';
+  }
+  return (
+    <div
+      aria-busy={busy}
+      className="border-border-light bg-surface-secondary relative min-h-64 flex-1 overflow-hidden rounded-lg border"
+    >
+      <div
+        ref={target}
+        hidden={role !== 'input'}
+        className="h-full min-h-64 w-full"
+        aria-label={localize('com_browser_interactive')}
+      />
+      <img
+        ref={picture}
+        hidden={role !== 'observe'}
+        className="h-full w-full object-contain"
+        alt={localize('com_browser_readonly')}
+      />
+      <canvas
+        ref={preview}
+        hidden={!frozen}
+        aria-hidden="true"
+        className="bg-surface-secondary pointer-events-none absolute inset-0 h-full w-full object-contain"
+      />
+      {busy && (
+        <div className="absolute inset-0 flex items-center justify-center p-4">
+          <div
+            role="status"
+            className="bg-surface-primary text-text-primary border-border-light flex items-center gap-3 rounded-lg border px-4 py-3 shadow-sm"
+          >
+            <Spinner />
+            <span className="text-sm">{localize(label)}</span>
+          </div>
+        </div>
+      )}
+      {failed && (
+        <div
+          role="alert"
+          className="bg-surface-primary absolute inset-0 flex flex-col items-center justify-center gap-3 p-4 text-center"
+        >
+          <p>{localize('com_browser_disconnected')}</p>
+          <Button disabled={!!pendingControl} onClick={() => setAttempt((value) => value + 1)}>
+            {localize('com_browser_reconnect')}
+          </Button>
+        </div>
+      )}
+    </div>
+  );
+}
