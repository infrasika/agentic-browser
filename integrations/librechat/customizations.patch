+import express from 'express';
+import request from 'supertest';
+import type { RequestHandler } from 'express';
+import { createTurnstileGuard } from './turnstile';
+function fixture(result: unknown, failing = false) {
+  const transport = jest
+    .fn<ReturnType<typeof fetch>, Parameters<typeof fetch>>()
+    .mockImplementation(async () => {
+      if (failing) throw new Error('sensitive-provider-detail');
+      return new Response(JSON.stringify(result));
+    });
+  const app = express();
+  app.use(express.json());
+  const account = jest.fn<ReturnType<RequestHandler>, Parameters<RequestHandler>>((_req, res) => {
+    res.json({ created: true });
+  });
+  app.post(
+    '/register',
+    createTurnstileGuard(
+      {
+        getConfig: async () => ({
+          siteKey: 'public-site-key',
+          verification: { required: true, hostname: 'demo.example', timeoutMs: 1000 },
+        }),
+        secret: 'private-secret',
+        transport,
+      },
+      'register',
+    ),
+    account,
+  );
+  return { app, transport, account };
+}
+describe('Turnstile account protection', () => {
+  test('missing challenge never creates an account', async () => {
+    const f = fixture({ success: true });
+    await request(f.app).post('/register').send({}).expect(400);
+    expect(f.transport).not.toHaveBeenCalled();
+    expect(f.account).not.toHaveBeenCalled();
+  });
+  test.each([
+    { success: false, 'error-codes': ['timeout-or-duplicate'] },
+    { success: true, hostname: 'wrong.example', action: 'register' },
+    { success: true, hostname: 'demo.example', action: 'login' },
+  ])('invalid challenge fails closed: %j', async (result) => {
+    const f = fixture(result);
+    await request(f.app).post('/register').send({ turnstileToken: 'challenge-token' }).expect(400);
+    expect(f.account).not.toHaveBeenCalled();
+  });
+  test('verified challenge reaches account creation without retaining the token', async () => {
+    const f = fixture({ success: true, hostname: 'demo.example', action: 'register' });
+    await request(f.app).post('/register').send({ turnstileToken: 'challenge-token' }).expect(200);
+    expect(f.account.mock.calls[0][0].body.turnstileToken).toBeUndefined();
+  });
+  test('provider outage does not create credits or disclose provider errors', async () => {
+    const f = fixture({}, true);
+    const r = await request(f.app)
+      .post('/register')
+      .send({ turnstileToken: 'challenge-token' })
+      .expect(503);
+    expect(r.text).not.toContain('sensitive');
+    expect(r.text).not.toContain('private-secret');
+    expect(f.account).not.toHaveBeenCalled();
+  });
+});
