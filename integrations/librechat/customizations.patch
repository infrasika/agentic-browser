@@ -0,0 +1,65 @@
+import { z } from 'zod';
+import type { TTurnstileConfig } from 'librechat-data-provider';
+import type { RequestHandler } from 'express';
+import type { BrowserTransport } from './client';
+
+export function createTurnstileGuard(
+  deps: {
+    getConfig: () => Promise<TTurnstileConfig | undefined>;
+    secret?: string;
+    transport: BrowserTransport;
+  },
+  action: 'login' | 'register',
+): RequestHandler {
+  return async (req, res, next) => {
+    try {
+      const config = await deps.getConfig();
+      if (!config?.verification?.required) {
+        next();
+        return;
+      }
+      if (!deps.secret || !config.siteKey) {
+        res.status(503).json({ error: 'challenge_unavailable' });
+        return;
+      }
+      const token = z.string().min(1).max(2048).safeParse(req.body?.turnstileToken);
+      if (!token.success) {
+        res.status(400).json({ error: 'challenge_required' });
+        return;
+      }
+      const response = await deps.transport(
+        'https://challenges.cloudflare.com/turnstile/v0/siteverify',
+        {
+          method: 'POST',
+          redirect: 'error',
+          signal: AbortSignal.timeout(config.verification.timeoutMs),
+          body: new URLSearchParams({ secret: deps.secret, response: token.data }),
+        },
+      );
+      if (!response.ok) {
+        res.status(503).json({ error: 'challenge_unavailable' });
+        return;
+      }
+      const verified = z
+        .object({
+          success: z.boolean(),
+          hostname: z.string().optional(),
+          action: z.string().optional(),
+        })
+        .parse(await response.json());
+      if (
+        !verified.success ||
+        verified.hostname !== config.verification.hostname ||
+        verified.action !== action
+      ) {
+        res.status(400).json({ error: 'challenge_invalid' });
+        return;
+      }
+      // Do not pass the single-use challenge token into account persistence or auth logs.
+      delete req.body.turnstileToken;
+      next();
+    } catch {
+      res.status(503).json({ error: 'challenge_unavailable' });
+    }
+  };
+}
