diff --git a/client/src/components/Demo/Admin.tsx b/client/src/components/Demo/Admin.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..86f64bdc17d7bd4ed99136557825039eb5237c0e
--- /dev/null
+++ b/client/src/components/Demo/Admin.tsx
@@ -0,0 +1,285 @@
+import { useState } from 'react';
+import { Link } from 'react-router-dom';
+import { Button, Input, Label, Spinner } from '@librechat/client';
+import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
+import { dataService, MutationKeys, QueryKeys, SystemRoles } from 'librechat-data-provider';
+import { useAuthContext, useLocalize } from '~/hooks';
+
+export default function DemoAdmin() {
+  const localize = useLocalize();
+  const { user } = useAuthContext();
+  const allowed = user?.role === SystemRoles.ADMIN;
+  const client = useQueryClient();
+  const [page, setPage] = useState(0);
+  const [limit, setLimit] = useState('');
+  const [target, setTarget] = useState('');
+  const [credits, setCredits] = useState('200000');
+  const [operation, setOperation] = useState(() => crypto.randomUUID());
+  const [success, setSuccess] = useState(false);
+  const budget = useQuery([QueryKeys.demoBudget, user?.id], dataService.getDemoBudget, {
+    enabled: allowed,
+    refetchInterval: 15000,
+    retry: false,
+  });
+  const accounts = useQuery(
+    [QueryKeys.demoAccounts, user?.id, page],
+    () => dataService.getDemoAccounts(page),
+    { enabled: allowed, retry: false },
+  );
+  const update = useMutation({
+    mutationKey: [MutationKeys.demoBudget],
+    mutationFn: dataService.updateDemoBudget,
+    onSuccess: () => {
+      setSuccess(true);
+      setLimit('');
+      client.invalidateQueries([QueryKeys.demoBudget]);
+    },
+    onError: () => {
+      client.invalidateQueries([QueryKeys.demoBudget]);
+    },
+  });
+  const credit = useMutation({
+    mutationKey: [MutationKeys.demoCredits],
+    mutationFn: () =>
+      dataService.addDemoCredits(target, { credits: Number(credits), id: operation }),
+    onSuccess: () => {
+      setSuccess(true);
+      setTarget('');
+      setOperation(crypto.randomUUID());
+      client.invalidateQueries([QueryKeys.demoAccounts]);
+      client.invalidateQueries([QueryKeys.balance]);
+    },
+  });
+  if (!allowed)
+    return (
+      <p role="alert" className="p-6">
+        {localize('com_demo_admin_only')}
+      </p>
+    );
+  const pending = update.isLoading || credit.isLoading;
+  const data = budget.data;
+  const limitNumber = Number(limit);
+  const creditNumber = Number(credits);
+  return (
+    <main className="bg-surface-primary text-text-primary h-full w-full overflow-y-auto p-4 md:p-8">
+      <div className="mx-auto flex max-w-5xl flex-col gap-6">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <h1 className="text-2xl font-semibold">{localize('com_demo_admin')}</h1>
+          <Button asChild variant="outline">
+            <Link to="/c/new">{localize('com_demo_back_chat')}</Link>
+          </Button>
+        </div>
+        {(budget.isLoading || accounts.isLoading) && <Spinner className="size-5" />}
+        {(budget.isError || accounts.isError || update.isError || credit.isError) && (
+          <div role="alert" className="text-text-destructive flex flex-wrap items-center gap-3">
+            <p>{localize('com_demo_failed')}</p>
+            <Button
+              variant="outline"
+              onClick={() => {
+                budget.refetch();
+                accounts.refetch();
+              }}
+            >
+              {localize('com_demo_refresh')}
+            </Button>
+          </div>
+        )}
+        {success && <p role="status">{localize('com_demo_saved')}</p>}
+        {data && (
+          <section
+            className="border-border-medium rounded-lg border p-4"
+            aria-labelledby="demo-budget-title"
+          >
+            <h2 id="demo-budget-title" className="text-lg font-semibold">
+              {localize('com_demo_daily_budget')}
+            </h2>
+            <p className="text-text-secondary text-sm">
+              {data.day} · {data.timeZone} · {localize('com_demo_midnight')}
+            </p>
+            <dl className="my-4 grid grid-cols-2 gap-4 md:grid-cols-4">
+              {(
+                [
+                  ['com_demo_limit', data.limitCredits],
+                  ['com_demo_spent', data.spentCredits],
+                  ['com_demo_reserved', data.reservedCredits],
+                  ['com_demo_remaining', data.remainingCredits],
+                ] as const
+              ).map(([key, value]) => (
+                <div key={key}>
+                  <dt className="text-text-secondary text-sm">{localize(key)}</dt>
+                  <dd className="text-lg font-semibold">{value.toLocaleString()}</dd>
+                </div>
+              ))}
+            </dl>
+            <p className="text-text-secondary text-sm">
+              {localize('com_demo_budget_note', { 0: (data.limitCredits / 1000000).toFixed(2) })}
+            </p>
+            {data.uncertainCredits > 0 && (
+              <p className="text-text-warning mt-2 text-sm">
+                {localize('com_demo_uncertain', { 0: data.uncertainCredits.toLocaleString() })}
+              </p>
+            )}
+            <form
+              className="mt-4 flex flex-wrap items-end gap-3"
+              onSubmit={(event) => {
+                event.preventDefault();
+                setSuccess(false);
+                update.mutate({ credits: limitNumber, revision: data.revision });
+              }}
+            >
+              <div className="flex flex-col gap-2">
+                <Label htmlFor="demo-limit">{localize('com_demo_new_limit')}</Label>
+                <Input
+                  id="demo-limit"
+                  type="number"
+                  min={0}
+                  max={1000000000}
+                  step={1}
+                  value={limit}
+                  onChange={(event) => setLimit(event.target.value)}
+                  placeholder={String(data.limitCredits)}
+                  disabled={pending}
+                />
+              </div>
+              <Button
+                type="submit"
+                disabled={
+                  pending ||
+                  limit === '' ||
+                  !Number.isSafeInteger(limitNumber) ||
+                  limitNumber < 0 ||
+                  limitNumber > 1000000000
+                }
+              >
+                {localize('com_demo_save_limit')}
+              </Button>
+            </form>
+          </section>
+        )}
+        <section
+          className="border-border-medium rounded-lg border p-4"
+          aria-labelledby="demo-users-title"
+        >
+          <h2 id="demo-users-title" className="mb-3 text-lg font-semibold">
+            {localize('com_demo_accounts')}
+          </h2>
+          {accounts.data?.users.length === 0 && <p>{localize('com_demo_no_accounts')}</p>}
+          <div className="overflow-x-auto">
+            <table className="w-full text-left text-sm">
+              <thead>
+                <tr>
+                  <th className="p-2">{localize('com_auth_email')}</th>
+                  <th className="p-2">{localize('com_demo_role')}</th>
+                  <th className="p-2">{localize('com_demo_credits')}</th>
+                  <th className="p-2">{localize('com_demo_actions')}</th>
+                </tr>
+              </thead>
+              <tbody>
+                {accounts.data?.users.map((account) => (
+                  <tr key={account.id} className="border-border-medium border-t">
+                    <td className="p-2 break-all">{account.email}</td>
+                    <td className="p-2">{account.role}</td>
+                    <td className="p-2">{account.credits?.toLocaleString() ?? '—'}</td>
+                    <td className="p-2">
+                      <Button
+                        variant="outline"
+                        size="sm"
+                        disabled={
+                          pending ||
+                          (account.role !== SystemRoles.USER &&
+                            account.role !== SystemRoles.ADMIN) ||
+                          account.credits == null
+                        }
+                        onClick={() => {
+                          setTarget(account.id);
+                          setOperation(crypto.randomUUID());
+                          setSuccess(false);
+                          credit.reset();
+                        }}
+                      >
+                        {localize('com_demo_add_credits')}
+                      </Button>
+                    </td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          {target && (
+            <form
+              className="mt-4 flex flex-wrap items-end gap-3"
+              onSubmit={(event) => {
+                event.preventDefault();
+                setSuccess(false);
+                credit.mutate();
+              }}
+            >
+              <div className="flex flex-col gap-2">
+                <Label htmlFor="demo-credit-amount">
+                  {localize('com_demo_topup_for', {
+                    0: accounts.data?.users.find((account) => account.id === target)?.email ?? '',
+                  })}
+                </Label>
+                <Input
+                  id="demo-credit-amount"
+                  type="number"
+                  min={1}
+                  max={10000000}
+                  step={1}
+                  value={credits}
+                  disabled={pending || credit.isError}
+                  onChange={(event) => setCredits(event.target.value)}
+                />
+              </div>
+              <Button
+                type="submit"
+                disabled={
+                  pending ||
+                  !Number.isSafeInteger(creditNumber) ||
+                  creditNumber < 1 ||
+                  creditNumber > 10000000
+                }
+              >
+                {localize('com_demo_confirm_topup')}
+              </Button>
+              <Button
+                type="button"
+                variant="outline"
+                disabled={pending}
+                onClick={() => {
+                  setTarget('');
+                  credit.reset();
+                }}
+              >
+                {localize('com_ui_cancel')}
+              </Button>
+            </form>
+          )}
+          <div className="mt-4 flex items-center gap-3">
+            <Button
+              variant="outline"
+              disabled={page === 0 || pending}
+              onClick={() => {
+                setPage(page - 1);
+                setTarget('');
+              }}
+            >
+              {localize('com_demo_previous')}
+            </Button>
+            <span>{page + 1}</span>
+            <Button
+              variant="outline"
+              disabled={!accounts.data || (page + 1) * 25 >= accounts.data.total || pending}
+              onClick={() => {
+                setPage(page + 1);
+                setTarget('');
+              }}
+            >
+              {localize('com_demo_next')}
+            </Button>
+          </div>
+        </section>
+      </div>
+    </main>
+  );
+}
diff --git a/client/src/components/Demo/__tests__/Admin.spec.tsx b/client/src/components/Demo/__tests__/Admin.spec.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..1c7538974c48608c960398cf6641e8109ffd7e53
--- /dev/null
+++ b/client/src/components/Demo/__tests__/Admin.spec.tsx
@@ -0,0 +1,138 @@
+import React from 'react';
+import { MemoryRouter } from 'react-router-dom';
+import { dataService } from 'librechat-data-provider';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import Admin from '../Admin';
+
+jest.mock('librechat-data-provider', () => {
+  const actual = jest.requireActual('librechat-data-provider');
+  return {
+    ...actual,
+    dataService: {
+      ...actual.dataService,
+      getDemoBudget: jest.fn(),
+      getDemoAccounts: jest.fn(),
+      updateDemoBudget: jest.fn(),
+      addDemoCredits: jest.fn(),
+    },
+  };
+});
+let mockRole = 'ADMIN';
+jest.mock('~/hooks', () => ({
+  useAuthContext: () => ({ user: { id: 'admin', role: mockRole } }),
+  useLocalize: () => (key: string) => key,
+}));
+const budget = {
+  day: '2026-10-24',
+  timeZone: 'Asia/Shanghai',
+  limitCredits: 20000000,
+  spentCredits: 10,
+  reservedCredits: 20,
+  remainingCredits: 19999970,
+  uncertainCredits: 0,
+  revision: 0,
+};
+let client: QueryClient;
+function mount() {
+  client = new QueryClient({
+    defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
+    logger: { log: () => {}, warn: () => {}, error: () => {} },
+  });
+  return render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter>
+        <Admin />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+beforeEach(() => {
+  mockRole = 'ADMIN';
+  Object.defineProperty(Element.prototype, 'getAnimations', {
+    configurable: true,
+    value: () => [],
+  });
+  jest.spyOn(dataService, 'getDemoBudget').mockResolvedValue(budget);
+  jest.spyOn(dataService, 'getDemoAccounts').mockResolvedValue({ users: [], total: 0, page: 0 });
+  Object.defineProperty(globalThis.crypto, 'randomUUID', {
+    configurable: true,
+    value: () => 'e18d417a-2f0e-4aeb-a90d-32633ba52a33',
+  });
+});
+afterEach(() => {
+  client?.clear();
+});
+test('ordinary accounts never fetch admin data', () => {
+  mockRole = 'USER';
+  mount();
+  expect(screen.getByRole('alert')).toHaveTextContent('com_demo_admin_only');
+  expect(dataService.getDemoBudget).not.toHaveBeenCalled();
+  expect(dataService.getDemoAccounts).not.toHaveBeenCalled();
+});
+test('renders empty accounts and saves an explicit zero budget with the current revision', async () => {
+  const save = jest
+    .spyOn(dataService, 'updateDemoBudget')
+    .mockResolvedValue({ ...budget, limitCredits: 0, revision: 1 });
+  mount();
+  expect(await screen.findByText('com_demo_no_accounts')).toBeInTheDocument();
+  fireEvent.change(screen.getByLabelText('com_demo_new_limit'), { target: { value: '0' } });
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_save_limit' }));
+  await waitFor(() => expect(save).toHaveBeenCalledWith({ credits: 0, revision: 0 }));
+  expect(await screen.findByRole('status')).toHaveTextContent('com_demo_saved');
+});
+test('a failed load offers a working refresh', async () => {
+  jest.spyOn(dataService, 'getDemoBudget').mockRejectedValueOnce(new Error('network unavailable'));
+  mount();
+  expect(await screen.findByRole('alert')).toHaveTextContent('com_demo_failed');
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_refresh' }));
+  expect(await screen.findByText('com_demo_daily_budget')).toBeInTheDocument();
+});
+test.each(['admin', 'another-admin'])('an administrator can add credits to %s', async (id) => {
+  jest.spyOn(dataService, 'getDemoAccounts').mockResolvedValue({
+    users: [{ id, email: 'admin@example.test', name: 'Administrator', role: 'ADMIN', credits: 0 }],
+    total: 1,
+    page: 0,
+  });
+  const topup = jest.spyOn(dataService, 'addDemoCredits').mockResolvedValue({ outcome: 'applied' });
+  mount();
+  const button = await screen.findByRole('button', { name: 'com_demo_add_credits' });
+  expect(button).toBeEnabled();
+  fireEvent.click(button);
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_confirm_topup' }));
+  await waitFor(() =>
+    expect(topup).toHaveBeenCalledWith(id, {
+      credits: 200000,
+      id: 'e18d417a-2f0e-4aeb-a90d-32633ba52a33',
+    }),
+  );
+  expect(await screen.findByRole('status')).toHaveTextContent('com_demo_saved');
+});
+test('uncertain top-up retry keeps the same id and amount', async () => {
+  jest.spyOn(dataService, 'getDemoAccounts').mockResolvedValue({
+    users: [
+      {
+        id: 'account',
+        email: 'fixture@example.test',
+        name: 'Fixture',
+        role: 'USER',
+        credits: 100,
+      },
+    ],
+    total: 1,
+    page: 0,
+  });
+  const topup = jest
+    .spyOn(dataService, 'addDemoCredits')
+    .mockRejectedValueOnce(new Error('connection lost'))
+    .mockResolvedValueOnce({ outcome: 'duplicate' });
+  mount();
+  fireEvent.click(await screen.findByRole('button', { name: 'com_demo_add_credits' }));
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_confirm_topup' }));
+  expect(await screen.findByRole('alert')).toBeInTheDocument();
+  expect(screen.getByLabelText('com_demo_topup_for')).toBeDisabled();
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_confirm_topup' }));
+  await waitFor(() => expect(topup).toHaveBeenCalledTimes(2));
+  expect(topup.mock.calls[0]).toEqual(topup.mock.calls[1]);
+  expect(await screen.findByRole('status')).toHaveTextContent('com_demo_saved');
+});
