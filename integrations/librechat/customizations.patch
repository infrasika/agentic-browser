diff --git a/packages/data-schemas/src/methods/demo.ts b/packages/data-schemas/src/methods/demo.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cf7d4e844bf705931f555e2c110509866f0dd2c7
--- /dev/null
+++ b/packages/data-schemas/src/methods/demo.ts
@@ -0,0 +1,85 @@
+import type { DemoAccountsResponse } from 'librechat-data-provider';
+import { createBalanceModel } from '~/models/balance';
+import { createUserModel } from '~/models/user';
+
+export interface DemoAdminMethods {
+  listDemoAccounts(page: number): Promise<DemoAccountsResponse>;
+  creditDemoAccount(input: {
+    userId: string;
+    actor: string;
+    id: string;
+    credits: number;
+  }): Promise<'applied' | 'duplicate' | 'missing'>;
+}
+
+export function createDemoAdminMethods(mongoose: typeof import('mongoose')): DemoAdminMethods {
+  const User = createUserModel(mongoose);
+  const Balance = createBalanceModel(mongoose);
+  return {
+    async listDemoAccounts(page) {
+      if (!Number.isSafeInteger(page) || page < 0 || page > 10000) throw new Error('Invalid page');
+      const [users, total] = await Promise.all([
+        User.find({})
+          .select('_id email name role')
+          .sort({ _id: -1 })
+          .skip(page * 25)
+          .limit(25)
+          .lean(),
+        User.countDocuments({}),
+      ]);
+      const balances = await Balance.find({ user: { $in: users.map((user) => user._id) } })
+        .select('user tokenCredits')
+        .lean();
+      const credits = new Map(
+        balances.map((balance) => [String(balance.user), balance.tokenCredits]),
+      );
+      return {
+        users: users.map((user) => ({
+          id: String(user._id),
+          email: user.email ?? '',
+          name: user.name ?? '',
+          role: user.role ?? 'USER',
+          credits: credits.get(String(user._id)) ?? null,
+        })),
+        total,
+        page,
+      };
+    },
+    async creditDemoAccount(input) {
+      if (
+        !mongoose.isValidObjectId(input.userId) ||
+        !/^[a-f0-9-]{36}$/.test(input.id) ||
+        !Number.isSafeInteger(input.credits) ||
+        input.credits <= 0 ||
+        input.credits > 10_000_000
+      )
+        throw new Error('Invalid credit adjustment');
+      const user = await User.findOne({ _id: input.userId, role: 'USER', provider: 'local' })
+        .select('_id')
+        .lean();
+      if (!user) return 'missing';
+      // Embed the operation id and audit in the SAME balance document as the
+      // increment. Standalone Mongo needs no multi-document transaction here.
+      const updated = await Balance.updateOne(
+        { user: input.userId, 'adminCredits.id': { $ne: input.id } },
+        {
+          $inc: { tokenCredits: input.credits },
+          $push: {
+            adminCredits: {
+              id: input.id,
+              actor: input.actor,
+              credits: input.credits,
+              at: new Date(),
+            },
+          },
+        },
+      );
+      if (updated.modifiedCount === 1) return 'applied';
+      const duplicate = await Balance.exists({
+        user: input.userId,
+        adminCredits: { $elemMatch: { id: input.id, actor: input.actor, credits: input.credits } },
+      });
+      return duplicate ? 'duplicate' : 'missing';
+    },
+  };
+}
