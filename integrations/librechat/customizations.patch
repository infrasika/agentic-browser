diff --git a/packages/data-schemas/src/methods/siteBudget.ts b/packages/data-schemas/src/methods/siteBudget.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cb6c8a060cc844d8241231cb612e04a8166725c3
--- /dev/null
+++ b/packages/data-schemas/src/methods/siteBudget.ts
@@ -0,0 +1,142 @@
+import type { SiteBudgetStatus } from 'librechat-data-provider';
+import { createSiteBudgetModel } from '~/models/siteBudget';
+
+export interface SiteBudgetPolicy {
+  initialLimitCredits: number;
+  timeZone: string;
+}
+
+export interface SiteBudgetMethods {
+  reserveSiteBudget(
+    input: SiteBudgetPolicy & { day: string; id: string; credits: number },
+  ): Promise<boolean>;
+  settleSiteBudget(input: {
+    day: string;
+    id: string;
+    credits: number;
+    uncertain: boolean;
+  }): Promise<void>;
+  getSiteBudget(input: SiteBudgetPolicy & { day: string }): Promise<SiteBudgetStatus>;
+  setSiteBudgetLimit(
+    input: SiteBudgetPolicy & { day: string; credits: number; revision: number; actor: string },
+  ): Promise<boolean>;
+}
+
+export function createSiteBudgetMethods(mongoose: typeof import('mongoose')): SiteBudgetMethods {
+  const Budget = createSiteBudgetModel(mongoose);
+  const dayPath = (day: string) => {
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) throw new Error('Invalid budget day');
+    return `days.${day}`;
+  };
+  const validCredits = (credits: number) => {
+    if (!Number.isSafeInteger(credits) || credits < 0) throw new Error('Invalid budget credits');
+  };
+  async function ensure(input: SiteBudgetPolicy & { day: string }) {
+    validCredits(input.initialLimitCredits);
+    try {
+      await Budget.updateOne(
+        { _id: 'global' },
+        {
+          $setOnInsert: {
+            limitCredits: input.initialLimitCredits,
+            revision: 0,
+            days: {},
+            changes: [],
+          },
+        },
+        { upsert: true },
+      );
+    } catch (error) {
+      if (!(error instanceof mongoose.mongo.MongoServerError && error.code === 11000)) throw error;
+    }
+    const path = dayPath(input.day);
+    await Budget.updateOne(
+      { _id: 'global', [path]: { $exists: false } },
+      { $set: { [path]: { spent: 0, reserved: 0, uncertain: 0, holds: [] } } },
+    );
+    return path;
+  }
+  return {
+    async reserveSiteBudget(input) {
+      validCredits(input.credits);
+      if (!/^[a-f0-9-]{36}$/.test(input.id)) throw new Error('Invalid reservation');
+      const path = await ensure(input);
+      const changed = await Budget.updateOne(
+        {
+          _id: 'global',
+          [`${path}.holds.id`]: { $ne: input.id },
+          $expr: {
+            $lte: [
+              { $add: [`$${path}.spent`, `$${path}.reserved`, input.credits] },
+              '$limitCredits',
+            ],
+          },
+        },
+        {
+          $inc: { [`${path}.reserved`]: input.credits },
+          $push: { [`${path}.holds`]: { id: input.id, credits: input.credits } },
+        },
+      );
+      return changed.modifiedCount === 1;
+    },
+    async settleSiteBudget(input) {
+      validCredits(input.credits);
+      const path = dayPath(input.day);
+      const current = await Budget.findById('global')
+        .select({ [`${path}.holds`]: 1 })
+        .lean();
+      const hold = current?.days[input.day]?.holds.find((item) => item.id === input.id);
+      if (!hold) return;
+      // The hold predicate makes concurrent/retried settlements idempotent. No
+      // TTL frees an uncertain in-flight call after a process crash.
+      await Budget.updateOne(
+        {
+          _id: 'global',
+          [`${path}.holds`]: { $elemMatch: { id: input.id, credits: hold.credits } },
+        },
+        {
+          $inc: {
+            [`${path}.reserved`]: -hold.credits,
+            [`${path}.spent`]: input.credits,
+            [`${path}.uncertain`]: input.uncertain ? input.credits : 0,
+          },
+          $pull: { [`${path}.holds`]: { id: input.id } },
+        },
+      );
+    },
+    async getSiteBudget(input) {
+      await ensure(input);
+      const current = await Budget.findById('global').lean();
+      if (!current) throw new Error('Budget unavailable');
+      const day = current.days[input.day];
+      return {
+        day: input.day,
+        timeZone: input.timeZone,
+        limitCredits: current.limitCredits,
+        spentCredits: day.spent,
+        reservedCredits: day.reserved,
+        uncertainCredits: day.uncertain,
+        remainingCredits: Math.max(0, current.limitCredits - day.spent - day.reserved),
+        revision: current.revision,
+      };
+    },
+    async setSiteBudgetLimit(input) {
+      validCredits(input.credits);
+      await ensure(input);
+      const changed = await Budget.updateOne(
+        { _id: 'global', revision: input.revision },
+        {
+          $set: { limitCredits: input.credits },
+          $inc: { revision: 1 },
+          $push: {
+            changes: {
+              $each: [{ actor: input.actor, limitCredits: input.credits, at: new Date() }],
+              $slice: -100,
+            },
+          },
+        },
+      );
+      return changed.modifiedCount === 1;
+    },
+  };
+}
