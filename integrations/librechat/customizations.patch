@@ -0,0 +1,53 @@
+import type { BrowserConfig, TContextUsageEvent } from 'librechat-data-provider';
+import type { Response } from 'express';
+import type { BalanceReservation, CheckBalanceDeps } from '../middleware/checkBalance';
+import type { ServerRequest } from '../types/http';
+import { checkBalance } from '../middleware/checkBalance';
+
+/** Resume bypasses BaseClient.sendMessage; reserve from the same ledger before replaying tools or calling the model. */
+export async function reserveBrowserResumeBalance(
+  input: {
+    browser?: BrowserConfig;
+    agentId: string;
+    req: ServerRequest;
+    res: Response;
+    user: string;
+    model?: string;
+    endpoint?: string;
+    endpointTokenConfig?: unknown;
+    contextUsage?: TContextUsageEvent;
+    maxContextTokens: number;
+  },
+  deps: CheckBalanceDeps,
+): Promise<BalanceReservation | undefined> {
+  if (
+    !input.browser?.enabled ||
+    !input.browser.agentIds.includes(input.agentId) ||
+    !deps.balanceConfig?.enabled
+  )
+    return undefined;
+  const usage = input.contextUsage;
+  const counted = usage?.breakdown
+    ? usage.breakdown.instructionTokens +
+      usage.breakdown.messageTokens +
+      (usage.completedOutputTokens ?? usage.resumedOutputTokens ?? 0) +
+      (usage.retainedToolTokens ?? 0)
+    : input.maxContextTokens;
+  if (!Number.isFinite(counted) || counted < 0)
+    throw new Error('Missing browser resume token budget');
+  return checkBalance(
+    {
+      req: input.req,
+      res: input.res,
+      txData: {
+        user: input.user,
+        model: input.model,
+        endpoint: input.endpoint,
+        endpointTokenConfig: input.endpointTokenConfig,
+        tokenType: 'prompt',
+        amount: Math.max(1, Math.ceil(counted)),
+      },
+    },
+    deps,
+  );
+}
