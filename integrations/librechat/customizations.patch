+import { siteBudgetSchema } from 'librechat-data-provider';
+import type { SiteBudgetMethods } from '@librechat/data-schemas';
+import type { BudgetTransport } from './fetch';
+import { createBudgetFetch, budgetDay } from './fetch';
+
+const config = siteBudgetSchema.parse({ enabled: true });
+const baseURL = 'https://provider.example/v1';
+const url = `${baseURL}/chat/completions`;
+const request = (stream = false) => ({
+  method: 'POST',
+  body: JSON.stringify({
+    model: 'demo',
+    messages: [{ role: 'user', content: 'hello' }],
+    stream,
+    max_tokens: 99999,
+  }),
+});
+const response = () =>
+  Response.json({ choices: [], usage: { prompt_tokens: 100, completion_tokens: 10 } });
+function setup(transport: BudgetTransport = jest.fn(async () => response())) {
+  const db = {
+    reserveSiteBudget: jest.fn<
+      ReturnType<SiteBudgetMethods['reserveSiteBudget']>,
+      Parameters<SiteBudgetMethods['reserveSiteBudget']>
+    >(async () => true),
+    settleSiteBudget: jest.fn<
+      ReturnType<SiteBudgetMethods['settleSiteBudget']>,
+      Parameters<SiteBudgetMethods['settleSiteBudget']>
+    >(async () => {}),
+  };
+  const fetcher = createBudgetFetch({
+    config,
+    baseURL,
+    rates: { demo: { prompt: 0.276, completion: 1.101 } },
+    db,
+    transport,
+  });
+  return { db, transport, fetcher };
+}
+test('Shanghai rollover occurs at 16:00 UTC', () => {
+  expect(budgetDay('Asia/Shanghai', new Date('2026-10-24T15:59:59Z'))).toBe('2026-10-24');
+  expect(budgetDay('Asia/Shanghai', new Date('2026-10-24T16:00:00Z'))).toBe('2026-10-25');
+});
+test('a denied or unavailable ledger never contacts the model', async () => {
+  const { db, transport, fetcher } = setup();
+  db.reserveSiteBudget.mockResolvedValueOnce(false);
+  expect((await fetcher(url, request())).status).toBe(402);
+  db.reserveSiteBudget.mockRejectedValueOnce(new Error('secret database URI'));
+  const result = await fetcher(url, request());
+  expect(result.status).toBe(503);
+  expect(await result.text()).not.toContain('secret');
+  expect(transport).not.toHaveBeenCalled();
+});
+test('clamps output and accounts actual non-stream usage independently of personal credits', async () => {
+  const { db, transport, fetcher } = setup();
+  expect((await fetcher(url, request())).status).toBe(200);
+  const sent = JSON.parse((transport as jest.Mock).mock.calls[0][1].body);
+  expect(sent.max_tokens).toBe(4096);
+  expect(sent.n).toBe(1);
+  expect(db.settleSiteBudget).toHaveBeenCalledWith(
+    expect.objectContaining({ credits: 39, uncertain: false }),
+  );
+});
+test('SSE usage survives split frames, CRLF and a final line without newline', async () => {
+  const encoded = new TextEncoder().encode(
+    'data: {"choices":[]}\r\ndata: {"usage":{"prompt_tokens":100,"completion_tokens":10}}',
+  );
+  const { fetcher, db, transport } = setup(
+    jest.fn(
+      async () =>
+        new Response(
+          new ReadableStream({
+            start(controller) {
+              controller.enqueue(encoded.slice(0, 38));
+              controller.enqueue(encoded.slice(38));
+              controller.close();
+            },
+          }),
+        ),
+    ),
+  );
+  const result = await fetcher(url, request(true));
+  await result.text();
+  expect(
+    JSON.parse((transport as jest.Mock).mock.calls[0][1].body).stream_options.include_usage,
+  ).toBe(true);
+  expect(db.settleSiteBudget).toHaveBeenCalledTimes(1);
+  expect(db.settleSiteBudget).toHaveBeenCalledWith(
+    expect.objectContaining({ credits: 39, uncertain: false }),
+  );
+});
+test('missing usage, provider failure and cancellation retain conservative cost', async () => {
+  for (const transport of [
+    jest.fn(async () => Response.json({ choices: [] })),
+    jest.fn(async () => {
+      throw new Error('secret key');
+    }),
+  ]) {
+    const { fetcher, db } = setup(transport);
+    try {
+      await fetcher(url, request());
+    } catch (error) {
+      expect(String(error)).not.toContain('secret');
+    }
+    expect(db.settleSiteBudget).toHaveBeenCalledWith(
+      expect.objectContaining({
+        credits: db.reserveSiteBudget.mock.calls[0][0].credits,
+        uncertain: true,
+      }),
+    );
+  }
+  const { fetcher, db } = setup(
+    jest.fn(
+      async () =>
+        new Response(
+          new ReadableStream({
+            start(controller) {
+              controller.enqueue(new TextEncoder().encode('data: {}\n'));
+            },
+          }),
+        ),
+    ),
+  );
+  const result = await fetcher(url, request(true));
+  await result.body?.cancel();
+  expect(db.settleSiteBudget).toHaveBeenCalledWith(expect.objectContaining({ uncertain: true }));
+});
+test('explicit provider rejection releases hold, while failed settlement cannot release it', async () => {
+  const rejected = setup(jest.fn(async () => new Response('{}', { status: 429 })));
+  await rejected.fetcher(url, request());
+  expect(rejected.db.settleSiteBudget).toHaveBeenCalledWith(
+    expect.objectContaining({ credits: 0, uncertain: false }),
+  );
+  const failure = setup();
+  failure.db.settleSiteBudget.mockRejectedValueOnce(new Error('private database diagnostic'));
+  expect((await failure.fetcher(url, request())).status).toBe(200);
+  expect(failure.db.settleSiteBudget).toHaveBeenCalledTimes(1);
+});
+test('unsupported requests fail before spending, including images and unpriced models', async () => {
+  const { fetcher, transport } = setup();
+  for (const change of [
+    { model: 'unknown' },
+    { n: 2 },
+    {
+      messages: [{ content: [{ type: 'image_url', image_url: { url: 'https://example.test' } }] }],
+    },
+    { messages: [{ content: 'a'.repeat(64000) }] },
+  ]) {
+    const input = request();
+    input.body = JSON.stringify({ ...JSON.parse(input.body), ...change });
+    expect((await fetcher(url, input)).ok).toBe(false);
+  }
+  expect((await fetcher('https://other.example/v1/chat/completions', request())).status).toBe(400);
+  expect(transport).not.toHaveBeenCalled();
+});
