+describe('Assistant tool schemas', () => {
+  it('preserves required inputs, descriptions, bounds and input transforms with Zod 4', () => {
+    const result = formatToOpenAIAssistantTool({
+      name: 'read_repositories',
+      description: 'Read repository names.',
+      schema: z.object({
+        owner: z
+          .string()
+          .min(1)
+          .describe('GitHub account')
+          .transform((value) => value.trim()),
+        limit: z.number().int().min(1).max(100).default(20),
+      }),
+    });
+    expect(result.type).toBe('function');
+    expect(result.function.parameters).toMatchObject({
+      type: 'object',
+      properties: {
+        owner: { type: 'string', minLength: 1, description: 'GitHub account' },
+        limit: { type: 'integer', minimum: 1, maximum: 100, default: 20 },
+      },
+    });
+    expect(result.function.parameters.required).toContain('owner');
+  });
+
+  it('preserves tools already described by JSON Schema', () => {
+    const schema = { type: 'object', properties: { url: { type: 'string' } }, required: ['url'] };
+    expect(formatToOpenAIAssistantTool({ name: 'open', schema }).function.parameters).toEqual(
+      schema,
+    );
+  });
+});
