+++ b/packages/api/src/browser/wait.ts
@@ -0,0 +1,12 @@
+import { interrupt } from '@langchain/langgraph';
+import { browserWaitSchema } from 'librechat-data-provider';
+import type { BrowserWait } from 'librechat-data-provider';
+export type { BrowserWait } from 'librechat-data-provider';
+
+/** Resume is only a wake-up: tools recheck authoritative state before proceeding. */
+export function waitForBrowser(payload: BrowserWait): void {
+  interrupt(browserWaitSchema.parse(payload));
+}
+export function isBrowserWait(payload: unknown): payload is BrowserWait {
+  return browserWaitSchema.safeParse(payload).success;
+}
