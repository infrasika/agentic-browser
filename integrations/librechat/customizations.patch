+require('@librechat/data-schemas').createModels(require('mongoose'));
+require('module-alias')({ base: require('path').resolve(__dirname, '..', 'api') });
+const { bootstrapBrowserDemo } = require('@librechat/api');
+const { registerUser } = require('~/server/services/AuthService');
+const { grantPermission } = require('~/server/services/PermissionService');
+const db = require('~/models');
+const connect = require('./connect');
+connect()
+  .then(() => db.seedDatabase())
+  .then(() =>
+    bootstrapBrowserDemo(
+      {
+        email: process.env.DEMO_ADMIN_EMAIL,
+        password: process.env.DEMO_ADMIN_PASSWORD,
+        model: process.env.QWEN_MODEL,
+        agentId: 'agent_browser_demo',
+        provider: 'Qwen',
+        definition: require('./browser-demo.json'),
+      },
+      { ...db, registerUser, grantPermission },
+    ),
+  )
+  .then(console.log)
+  .then(() => process.exit(0))
+  .catch((error) => {
+    console.error(
+      'Browser demo bootstrap failed. Check the private configuration and database state.',
+      { kind: error?.name },
+    );
+    process.exit(1);
+  });
