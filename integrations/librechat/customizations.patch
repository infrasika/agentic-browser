+import React from 'react';
+import { browserDataService } from 'librechat-data-provider';
+import { act, fireEvent, render, screen } from '@testing-library/react';
+import type { BrowserLease } from 'librechat-data-provider';
+import Screen from '../Screen';
+
+const mockDesktops: Array<EventTarget & { viewOnly: boolean }> = [];
+jest.mock('@novnc/novnc', () => ({
+  __esModule: true,
+  default: class extends EventTarget {
+    viewOnly = false;
+    constructor(target: HTMLElement) {
+      super();
+      const canvas = globalThis.document.createElement('canvas');
+      canvas.width = 1280;
+      canvas.height = 720;
+      target.appendChild(canvas);
+      mockDesktops.push(this);
+    }
+
+    disconnect() {}
+  },
+}));
+jest.mock('~/hooks', () => ({ useLocalize: () => (key: string) => key }));
+
+class Socket extends EventTarget {
+  static OPEN = 1;
+  static instances: Socket[] = [];
+  readyState = 0;
+  onopen?: () => void;
+  onmessage?: (event: MessageEvent) => void;
+  send = jest.fn();
+  close = jest.fn();
+  constructor() {
+    super();
+    Socket.instances.push(this);
+  }
+
+  open() {
+    this.readyState = 1;
+    this.onopen?.();
+  }
+
+  end(code: number, reason = '') {
+    this.readyState = 3;
+    this.dispatchEvent(new CloseEvent('close', { code, reason }));
+  }
+
+  frame() {
+    this.onmessage?.(new MessageEvent('message', { data: new ArrayBuffer(4) }));
+  }
+}
+const lease: BrowserLease = {
+  id: '174ff560-d264-4054-9a22-210679bf704d',
+  userId: 'user',
+  conversationId: '174ff560-d264-4054-9a22-210679bf704e',
+  taskId: 'generation',
+  acquisitionId: 'acquisition',
+  purpose: 'test',
+  url: 'https://example.com',
+  state: 'active',
+  sessionId: '174ff560-d264-4054-9a22-210679bf704f',
+  createdAt: 1,
+  updatedAt: 1,
+  expiresAt: 9999999999999,
+  revision: 1,
+  control: 'human',
+  error: null,
+};
+let images: HTMLImageElement[];
+const refresh = jest.fn();
+const props = {
+  conversationId: lease.conversationId,
+  lease,
+  connectTimeoutMs: 30000,
+  onAccessChanged: refresh,
+};
+const nativeImage = window.Image;
+const nativeWebSocket = window.WebSocket;
+beforeEach(() => {
+  jest.useFakeTimers();
+  Socket.instances = [];
+  mockDesktops.length = 0;
+  images = [];
+  Object.defineProperty(globalThis, 'WebSocket', {
+    configurable: true,
+    writable: true,
+    value: Socket,
+  });
+  jest.spyOn(globalThis, 'Image').mockImplementation(() => {
+    const image = new nativeImage();
+    images.push(image);
+    return image;
+  });
+  Object.defineProperty(URL, 'createObjectURL', {
+    configurable: true,
+    value: jest.fn(() => `blob:frame-${images.length}`),
+  });
+  Object.defineProperty(URL, 'revokeObjectURL', { configurable: true, value: jest.fn() });
+  jest.spyOn(browserDataService, 'viewer').mockResolvedValue({
+    grant: 'viewer-token',
+    path: '/browser/v1/input',
+    expiresAt: 9999999999999,
+  });
+});
+afterEach(() => {
+  jest.useRealTimers();
+  globalThis.WebSocket = nativeWebSocket;
+});
+async function connect() {
+  await act(async () => {});
+  act(() => {
+    Socket.instances.at(-1)!.open();
+    mockDesktops.at(-1)?.dispatchEvent(new Event('connect'));
+  });
+}
+
+test('Done retains the canvas across revocation and waits for a decoded agent frame', async () => {
+  const view = render(<Screen {...props} />);
+  await connect();
+  view.rerender(<Screen {...props} pendingControl="agent" />);
+  expect(screen.getByText('com_browser_returning')).toBeVisible();
+  expect(mockDesktops[0].viewOnly).toBe(true);
+  const preview = view.container.querySelector('canvas[aria-hidden]')!;
+  expect(preview).toBeVisible();
+  act(() => {
+    Socket.instances[0].end(1008, 'Browser access changed');
+    mockDesktops[0].dispatchEvent(new Event('disconnect'));
+  });
+  expect(refresh).toHaveBeenCalledTimes(1);
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument();
+  view.rerender(<Screen {...props} lease={{ ...lease, revision: 2, control: 'agent' }} />);
+  await connect();
+  act(() => Socket.instances[1].frame());
+  expect(preview).toBeVisible();
+  expect(screen.getByText('com_browser_updating')).toBeVisible();
+  act(() => fireEvent.load(images[0]));
+  expect(preview).not.toBeVisible();
+  expect(preview).toHaveAttribute('width', '0');
+  expect(screen.queryByRole('status')).not.toBeInTheDocument();
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument();
+  view.unmount();
+  expect(URL.revokeObjectURL).toHaveBeenCalledWith('blob:frame-0');
+});
+
+test('agent-initiated handoff refreshes status without a disconnect alert', async () => {
+  const view = render(<Screen {...props} lease={{ ...lease, control: 'agent' }} />);
+  await connect();
+  act(() => {
+    Socket.instances[0].end(1008, 'Browser access changed');
+    Socket.instances[0].dispatchEvent(new Event('error'));
+  });
+  expect(refresh).toHaveBeenCalledTimes(1);
+  expect(screen.getByText('com_browser_updating')).toBeVisible();
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument();
+  view.rerender(<Screen {...props} lease={{ ...lease, revision: 2 }} />);
+  await connect();
+  expect(screen.queryByRole('status')).not.toBeInTheDocument();
+});
+
+test('a real connection failure offers a fresh viewer grant on retry', async () => {
+  render(<Screen {...props} />);
+  await connect();
+  act(() => Socket.instances[0].end(1006));
+  expect(screen.getByRole('alert')).toHaveTextContent('com_browser_disconnected');
+  fireEvent.click(screen.getByRole('button', { name: 'com_browser_reconnect' }));
+  await connect();
+  expect(browserDataService.viewer).toHaveBeenCalledTimes(2);
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument();
+});
+
+test('a stalled handoff times out instead of waiting forever', async () => {
+  render(<Screen {...props} />);
+  await connect();
+  act(() => Socket.instances[0].end(1008, 'Browser access changed'));
+  act(() => jest.advanceTimersByTime(30000));
+  expect(screen.getByRole('alert')).toBeVisible();
+  expect(screen.queryByRole('status')).not.toBeInTheDocument();
+});
+
+test('a rejected transfer restores input and removes its frozen preview', async () => {
+  const view = render(<Screen {...props} />);
+  await connect();
+  view.rerender(<Screen {...props} pendingControl="agent" />);
+  view.rerender(<Screen {...props} />);
+  expect(mockDesktops[0].viewOnly).toBe(false);
+  expect(view.container.querySelector('canvas[aria-hidden]')).not.toBeVisible();
+  expect(screen.queryByRole('status')).not.toBeInTheDocument();
+});
+
+test('late events from a replaced viewer cannot fail or refresh the current viewer', async () => {
+  const view = render(<Screen {...props} />);
+  await connect();
+  view.rerender(<Screen {...props} lease={{ ...lease, revision: 2 }} />);
+  await connect();
+  act(() => {
+    Socket.instances[0].end(1008, 'Browser access changed');
+    Socket.instances[0].dispatchEvent(new Event('error'));
+  });
+  expect(refresh).not.toHaveBeenCalled();
+  expect(screen.queryByRole('alert')).not.toBeInTheDocument();
+});
+
+test('unmount revokes an undecoded frame and ignores late viewer grants', async () => {
+  const view = render(<Screen {...props} lease={{ ...lease, control: 'agent' }} />);
+  await connect();
+  act(() => Socket.instances[0].frame());
+  view.unmount();
+  expect(URL.revokeObjectURL).toHaveBeenCalledWith('blob:frame-0');
+  expect(images[0].onload).toBeNull();
+  let resolve!: (grant: Awaited<ReturnType<typeof browserDataService.viewer>>) => void;
+  jest.mocked(browserDataService.viewer).mockReturnValueOnce(
+    new Promise((done) => {
+      resolve = done;
+    }),
+  );
+  const next = render(<Screen {...props} />);
+  next.unmount();
+  await act(async () => {
+    resolve({ grant: 'late', path: '/browser/v1/input', expiresAt: 9999999999999 });
+  });
+  expect(Socket.instances).toHaveLength(1);
+});
