+++ b/packages/api/src/browser/account.ts
@@ -0,0 +1,17 @@
+/** Read current account existence and the existing LibreChat user-ban store without depending on app globals. */
+export function createBrowserAccountAuthorizer(deps: {
+  findUser: (filter: { _id: string }, projection: string) => Promise<unknown>;
+  getBan: (userId: string) => Promise<{ expiresAt?: unknown } | null | undefined>;
+  bansEnabled: boolean;
+}): (userId: string) => Promise<boolean> {
+  return async (userId) => {
+    const [user, ban] = await Promise.all([
+      deps.findUser({ _id: userId }, '_id'),
+      deps.bansEnabled ? deps.getBan(userId) : undefined,
+    ]);
+    if (!user) return false;
+    if (!ban) return true;
+    const expiresAt = Number(ban.expiresAt);
+    return Number.isFinite(expiresAt) && expiresAt > 0 && expiresAt <= Date.now();
+  };
+}
