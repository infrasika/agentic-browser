@@ -0,0 +1,17 @@
+import { createHash } from 'node:crypto';
+import { browserPrincipalSchema } from 'librechat-data-provider';
+import type { BrowserPrincipal } from 'librechat-data-provider';
+
+/** A task is a server-created generation, stable across checkpoint resumes. */
+export function browserPrincipal(
+  userId: string,
+  conversationId: string,
+  createdAt: number,
+): BrowserPrincipal {
+  if (!Number.isFinite(createdAt) || createdAt <= 0)
+    throw new Error('Missing browser generation identity');
+  const taskId = createHash('sha256')
+    .update(JSON.stringify([userId, conversationId, createdAt]))
+    .digest('hex');
+  return browserPrincipalSchema.parse({ userId, conversationId, taskId });
+}
