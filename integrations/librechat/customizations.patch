+++ b/packages/api/src/browser/runtime.ts
@@ -0,0 +1,328 @@
+import { z } from 'zod';
+import { createHmac, timingSafeEqual } from 'node:crypto';
+import { browserConfigSchema } from 'librechat-data-provider';
+import type {
+  Agents,
+  BrowserConfig,
+  BrowserLease,
+  BrowserPrincipal,
+} from 'librechat-data-provider';
+import type { BrowserTransport, BrowserResult } from './client';
+import type { GenerationJob } from '../types/stream';
+import type { BrowserBinding } from './tools';
+import { browserPrincipal } from './identity';
+import { BrowserClient } from './client';
+import { isBrowserWait } from './wait';
+
+type JobView = Pick<GenerationJob, 'status' | 'createdAt' | 'metadata'>;
+export interface BrowserDependencies {
+  config?: BrowserConfig;
+  token?: string;
+  transport: BrowserTransport;
+  getJob: (conversationId: string) => Promise<JobView | undefined>;
+  getActiveJobIdsForUser: (userId: string, tenantId?: string) => Promise<string[]>;
+  abortJob: (
+    conversationId: string,
+    options: { expectedCreatedAt: number; awaitProviderDrain: boolean },
+  ) => Promise<{ success: boolean; failureReason?: string }>;
+  signUserToken: (userId: string, expiresIn: string) => string | Promise<string>;
+  onFailure: (code: string) => void;
+  authorizeUser: (userId: string) => Promise<boolean>;
+  now?: () => number;
+}
+const terminal = new Set(['completed', 'cancelled', 'failed', 'expired']);
+const taskMatches = (job: JobView, principal: BrowserPrincipal) =>
+  job.metadata.userId === principal.userId &&
+  browserPrincipal(principal.userId, principal.conversationId, job.createdAt).taskId ===
+    principal.taskId;
+const wakeable = (lease: BrowserLease) =>
+  (terminal.has(lease.state) && lease.state !== 'cancelled') ||
+  (lease.state === 'active' && lease.control === 'agent');
+
+export class BrowserIntegration {
+  readonly client: BrowserClient;
+  private timer?: ReturnType<typeof setTimeout>;
+  private polling?: Promise<void>;
+  private origin?: string;
+  private stopped = false;
+  private failed = false;
+  private now: () => number;
+  constructor(private deps: BrowserDependencies & { config: BrowserConfig; token: string }) {
+    this.client = new BrowserClient(deps.config, deps.token, deps.transport);
+    this.now = deps.now ?? Date.now;
+  }
+
+  bind(
+    input: { userId: string; conversationId: string; createdAt: number },
+    signal: AbortSignal,
+  ): BrowserBinding {
+    return {
+      client: this.client,
+      principal: browserPrincipal(input.userId, input.conversationId, input.createdAt),
+      signal,
+      agentIds: this.deps.config.agentIds,
+    };
+  }
+
+  async current(
+    userId: string,
+    conversationId: string,
+    tenantId?: string,
+  ): Promise<BrowserResult<{
+    principal: BrowserPrincipal;
+    lease: BrowserLease | null;
+    status: GenerationJob['status'];
+  }> | null> {
+    const job = await this.deps.getJob(conversationId);
+    if (
+      !job ||
+      job.metadata.userId !== userId ||
+      (job.metadata.tenantId != null && job.metadata.tenantId !== tenantId)
+    )
+      return null;
+    const principal = browserPrincipal(userId, conversationId, job.createdAt);
+    const found = await this.client.task(principal);
+    if (!found.ok) return found;
+    return {
+      ok: true as const,
+      value: { principal, lease: found.value.lease, status: job.status },
+    };
+  }
+
+  /** Stop this user's native browser generations before revoking their viewers/leases. */
+  async revokeUser(userId: string, tenantId?: string): Promise<void> {
+    let stoppedAll = true;
+    try {
+      const ids = await this.deps.getActiveJobIdsForUser(userId, tenantId);
+      for (const conversationId of ids) {
+        const job = await this.deps.getJob(conversationId);
+        if (
+          !job ||
+          job.metadata.userId !== userId ||
+          (job.metadata.tenantId != null && job.metadata.tenantId !== tenantId) ||
+          !this.deps.config.agentIds.includes(job.metadata.agent_id ?? '') ||
+          ['complete', 'error', 'aborted'].includes(job.status)
+        )
+          continue;
+        const stopped = await this.deps.abortJob(conversationId, {
+          expectedCreatedAt: job.createdAt,
+          awaitProviderDrain: true,
+        });
+        if (!stopped.success) throw new Error('Browser generation cancellation pending');
+      }
+    } catch {
+      stoppedAll = false;
+    }
+    const result = await this.client.revokeUser(userId);
+    if (!result.ok || !stoppedAll) throw new Error('Browser revocation pending');
+  }
+
+  private proof(
+    principal: BrowserPrincipal,
+    actionId: string,
+    leaseId: string,
+    timestamp: number,
+  ): string {
+    return createHmac('sha256', this.deps.token)
+      .update(JSON.stringify(['browser-resume-v1', principal, actionId, leaseId, timestamp]))
+      .digest('hex');
+  }
+
+  async authorizeResume(
+    input: { userId: string; conversationId: string; createdAt: number },
+    pending: Agents.PendingAction,
+    proof: unknown,
+  ): Promise<boolean> {
+    if (!isBrowserWait(pending.payload)) return false;
+    const parsed = z
+      .object({ timestamp: z.number().int(), signature: z.string().regex(/^[a-f0-9]{64}$/) })
+      .strict()
+      .safeParse(proof);
+    if (
+      !parsed.success ||
+      parsed.data.timestamp > this.now() ||
+      this.now() - parsed.data.timestamp > this.deps.config.resumeProofTtlMs
+    )
+      return false;
+    const principal = browserPrincipal(input.userId, input.conversationId, input.createdAt);
+    const expected = Buffer.from(
+      this.proof(principal, pending.actionId, pending.payload.leaseId, parsed.data.timestamp),
+      'hex',
+    );
+    if (!timingSafeEqual(expected, Buffer.from(parsed.data.signature, 'hex'))) return false;
+    const live = await this.client.lease(pending.payload.leaseId, principal);
+    return live.ok && wakeable(live.value);
+  }
+
+  /** Authenticated loopback automation may enter the normal resume route without a browser UA. */
+  async isInternalResume(input: {
+    userId: string;
+    tenantId?: string;
+    conversationId: unknown;
+    actionId: unknown;
+    proof: unknown;
+  }): Promise<boolean> {
+    if (typeof input.conversationId !== 'string' || typeof input.actionId !== 'string')
+      return false;
+    const job = await this.deps.getJob(input.conversationId);
+    if (
+      !job ||
+      job.status !== 'requires_action' ||
+      job.metadata.userId !== input.userId ||
+      (job.metadata.tenantId != null && job.metadata.tenantId !== input.tenantId) ||
+      job.metadata.pendingAction?.actionId !== input.actionId
+    )
+      return false;
+    return this.authorizeResume(
+      { userId: input.userId, conversationId: input.conversationId, createdAt: job.createdAt },
+      job.metadata.pendingAction,
+      input.proof,
+    );
+  }
+
+  start(address: { port: number } | string | null): void {
+    if (!address || typeof address === 'string')
+      throw new Error('Browser recovery requires a TCP listener');
+    this.origin = `http://127.0.0.1:${address.port}`;
+    const schedule = () => {
+      if (this.stopped) return;
+      this.timer = setTimeout(() => {
+        this.polling = this.tick()
+          .then(() => {
+            this.failed = false;
+          })
+          .catch(() => {
+            if (!this.failed) this.deps.onFailure('browser_recovery_unavailable');
+            this.failed = true;
+          })
+          .finally(() => {
+            this.polling = undefined;
+            schedule();
+          });
+      }, this.deps.config.pollIntervalMs);
+      this.timer.unref();
+    };
+    schedule();
+  }
+
+  async stop(): Promise<void> {
+    this.stopped = true;
+    clearTimeout(this.timer);
+    await this.polling;
+  }
+
+  async tick(): Promise<void> {
+    const [live, outbox] = await Promise.all([this.client.leases(), this.client.events()]);
+    if (!live.ok || !outbox.ok) throw new Error('Browser recovery unavailable');
+    const visited = new Map<string, boolean>();
+    for (const lease of live.value.leases) visited.set(lease.id, await this.reconcile(lease));
+    for (const event of outbox.value.events) {
+      let acknowledged = visited.get(event.leaseId);
+      if (acknowledged == null) {
+        const lease = await this.client.lease(event.leaseId, event);
+        if (!lease.ok) throw new Error('Browser event lookup failed');
+        acknowledged = await this.reconcile(lease.value);
+        visited.set(event.leaseId, acknowledged);
+      }
+      if (!acknowledged) break;
+      const ack = await this.client.ack(event.id);
+      if (!ack.ok) throw new Error('Browser event acknowledgement failed');
+    }
+  }
+
+  private async reconcile(lease: BrowserLease): Promise<boolean> {
+    if (!(await this.deps.authorizeUser(lease.userId))) {
+      if (terminal.has(lease.state)) return true;
+      const released = await this.client.revokeUser(lease.userId);
+      return released.ok;
+    }
+    const job = await this.deps.getJob(lease.conversationId);
+    if (!job || !taskMatches(job, lease) || ['complete', 'error', 'aborted'].includes(job.status)) {
+      if (!terminal.has(lease.state)) {
+        const released = await this.client.release(lease.id, lease);
+        if (!released.ok) return false;
+      }
+      return true;
+    }
+    if (lease.state === 'cancelled') {
+      const stopped = await this.deps.abortJob(lease.conversationId, {
+        expectedCreatedAt: job.createdAt,
+        awaitProviderDrain: true,
+      });
+      return stopped.success;
+    }
+    const pending = job.metadata.pendingAction;
+    if (
+      job.status !== 'requires_action' ||
+      !pending ||
+      !isBrowserWait(pending.payload) ||
+      pending.payload.leaseId !== lease.id
+    ) {
+      // Retain terminal events until an in-flight tool has persisted its pause.
+      return !terminal.has(lease.state);
+    }
+    if (!wakeable(lease)) return true;
+    if (!this.origin) return false;
+    const principal = browserPrincipal(lease.userId, lease.conversationId, job.createdAt);
+    const timestamp = this.now();
+    const token = await this.deps.signUserToken(lease.userId, '60s');
+    const response = await this.deps.transport(`${this.origin}/api/agents/chat/resume`, {
+      method: 'POST',
+      redirect: 'error',
+      signal: AbortSignal.timeout(this.deps.config.requestTimeoutMs),
+      headers: {
+        authorization: `Bearer ${token}`,
+        'content-type': 'application/json',
+        'x-librechat-generation-protocol': String(job.metadata.generationProtocolVersion ?? 1),
+      },
+      body: JSON.stringify({
+        conversationId: lease.conversationId,
+        actionId: pending.actionId,
+        generationCreatedAt: job.createdAt,
+        browserProof: {
+          timestamp,
+          signature: this.proof(principal, pending.actionId, lease.id, timestamp),
+        },
+      }),
+    });
+    if (
+      (response.status === 202 || response.status === 200) &&
+      response.headers.get('content-type')?.includes('application/json')
+    ) {
+      const receipt = (await response.json()) as { conversationId?: string; status?: string };
+      if (receipt.conversationId === lease.conversationId && receipt.status === 'resuming')
+        return true;
+    } else {
+      await response.body?.cancel();
+    }
+    // A denied account/permission/balance cannot keep using a browser. Transient failures retry.
+    if ([401, 403, 402].includes(response.status)) {
+      await this.client.release(lease.id, lease);
+      this.deps.onFailure('browser_resume_denied');
+    }
+    return false;
+  }
+}
+export function createBrowserIntegration(
+  deps: BrowserDependencies,
+): BrowserIntegration | undefined {
+  if (!deps.config?.enabled) return undefined;
+  if (!deps.token) throw new Error('Browser service credential is missing');
+  return new BrowserIntegration({
+    ...deps,
+    config: browserConfigSchema.parse(deps.config),
+    token: deps.token,
+  });
+}
+
+export function getBrowserClientConfig(
+  config?: BrowserConfig,
+): Pick<BrowserConfig, 'agentIds' | 'pollIntervalMs' | 'viewerConnectTimeoutMs'> | undefined {
+  return config?.enabled
+    ? {
+        agentIds: config.agentIds,
+        pollIntervalMs: config.pollIntervalMs,
+        viewerConnectTimeoutMs: config.viewerConnectTimeoutMs,
+      }
+    : undefined;
+}
