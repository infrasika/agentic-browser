--- /dev/null
+++ b/packages/api/src/budget/admin.ts
@@ -0,0 +1,91 @@
+import { z } from 'zod';
+import { Router } from 'express';
+import { siteBudgetSchema, SystemRoles } from 'librechat-data-provider';
+import type { SiteBudgetMethods, DemoAdminMethods } from '@librechat/data-schemas';
+import type { RequestHandler } from 'express';
+import type { ServerRequest } from '~/types/http';
+import { budgetDay } from './fetch';
+
+/** Same-origin session-authenticated UI. The caller mounts JWT and config
+ * middleware first; this router independently requires ADMIN on every request. */
+export function createDemoAdminRouter(
+  deps: SiteBudgetMethods & DemoAdminMethods,
+): ReturnType<typeof Router> {
+  const router = Router();
+  router.use(((req: ServerRequest, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    if (req.user?.role !== SystemRoles.ADMIN || req.user.tenantId) {
+      res.status(403).json({ error: 'admin_required' });
+      return;
+    }
+    if (!req.config?.balance?.siteBudget?.enabled) {
+      res.status(404).json({ error: 'demo_admin_disabled' });
+      return;
+    }
+    next();
+  }) as RequestHandler);
+  router.all(['/', '/users', '/budget', '/users/:userId/credits'], (async (
+    req: ServerRequest,
+    res,
+  ) => {
+    try {
+      const config = siteBudgetSchema.parse(req.config?.balance?.siteBudget);
+      const policy = {
+        day: budgetDay(config.timeZone),
+        initialLimitCredits: config.dailyCredits,
+        timeZone: config.timeZone,
+      };
+      const actor = req.user?.id;
+      if (!actor) {
+        res.status(403).json({ error: 'admin_required' });
+        return;
+      }
+      if (req.method === 'GET' && req.path === '/') {
+        res.json(await deps.getSiteBudget(policy));
+        return;
+      }
+      if (req.method === 'GET' && req.path === '/users') {
+        const page = z.coerce
+          .number()
+          .int()
+          .min(0)
+          .max(10000)
+          .parse(req.query.page ?? 0);
+        res.json(await deps.listDemoAccounts(page));
+        return;
+      }
+      if (req.method !== 'POST') {
+        res.status(405).json({ error: 'method_not_allowed' });
+        return;
+      }
+      if (req.path === '/budget') {
+        const data = z
+          .object({
+            credits: z.number().int().min(0).max(1_000_000_000),
+            revision: z.number().int().nonnegative(),
+          })
+          .strict()
+          .parse(req.body);
+        const applied = await deps.setSiteBudgetLimit({ ...policy, ...data, actor });
+        res
+          .status(applied ? 200 : 409)
+          .json(applied ? await deps.getSiteBudget(policy) : { error: 'revision_conflict' });
+        return;
+      }
+      const data = z
+        .object({ credits: z.number().int().positive().max(10_000_000), id: z.string().uuid() })
+        .strict()
+        .parse(req.body);
+      const userId = z
+        .object({ userId: z.string().regex(/^[a-f0-9]{24}$/i) })
+        .parse(req.params).userId;
+      const outcome = await deps.creditDemoAccount({ ...data, userId, actor });
+      res.status(outcome === 'missing' ? 409 : 200).json({ outcome });
+    } catch (error) {
+      res.status(error instanceof z.ZodError ? 400 : 503).json({
+        error: error instanceof z.ZodError ? 'invalid_request' : 'demo_admin_unavailable',
+      });
+    }
+  }) as RequestHandler);
+  return router;
+}
