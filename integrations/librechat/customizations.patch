+): Promise<BalanceReservation | undefined> {
+  if (
+    !input.browser?.enabled ||
+    !input.browser.agentIds.includes(input.agentId) ||
+    !deps.balanceConfig?.enabled
+  )
+    return undefined;
+  const usage = input.contextUsage;
+  const counted = usage?.breakdown
+    ? usage.breakdown.instructionTokens +
+      usage.breakdown.messageTokens +
+      (usage.completedOutputTokens ?? usage.resumedOutputTokens ?? 0) +
+      (usage.retainedToolTokens ?? 0)
+    : input.maxContextTokens;
+  if (!Number.isFinite(counted) || counted < 0)
+    throw new Error('Missing browser resume token budget');
+  return checkBalance(
+    {
+      req: input.req,
+      res: input.res,
+      txData: {
+        user: input.user,
+        model: input.model,
+        endpoint: input.endpoint,
+        endpointTokenConfig: input.endpointTokenConfig,
+        tokenType: 'prompt',
+        amount: Math.max(1, Math.ceil(counted)),
+      },
+    },
+    deps,
+  );
+}
