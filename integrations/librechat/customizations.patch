+import React from 'react';
+import { MemoryRouter } from 'react-router-dom';
+import { dataService } from 'librechat-data-provider';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import Admin from '../Admin';
+
+jest.mock('librechat-data-provider', () => {
+  const actual = jest.requireActual('librechat-data-provider');
+  return {
+    ...actual,
+    dataService: {
+      ...actual.dataService,
+      getDemoBudget: jest.fn(),
+      getDemoAccounts: jest.fn(),
+      updateDemoBudget: jest.fn(),
+      addDemoCredits: jest.fn(),
+    },
+  };
+});
+let mockRole = 'ADMIN';
+jest.mock('~/hooks', () => ({
+  useAuthContext: () => ({ user: { id: 'admin', role: mockRole } }),
+  useLocalize: () => (key: string) => key,
+}));
+const budget = {
+  day: '2026-10-24',
+  timeZone: 'Asia/Shanghai',
+  limitCredits: 20000000,
+  spentCredits: 10,
+  reservedCredits: 20,
+  remainingCredits: 19999970,
+  uncertainCredits: 0,
+  revision: 0,
+};
+let client: QueryClient;
+function mount() {
+  client = new QueryClient({
+    defaultOptions: { queries: { retry: false }, mutations: { retry: false } },
+    logger: { log: () => {}, warn: () => {}, error: () => {} },
+  });
+  return render(
+    <QueryClientProvider client={client}>
+      <MemoryRouter>
+        <Admin />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+}
+beforeEach(() => {
+  mockRole = 'ADMIN';
+  Object.defineProperty(Element.prototype, 'getAnimations', {
+    configurable: true,
+    value: () => [],
+  });
+  jest.spyOn(dataService, 'getDemoBudget').mockResolvedValue(budget);
+  jest.spyOn(dataService, 'getDemoAccounts').mockResolvedValue({ users: [], total: 0, page: 0 });
+  Object.defineProperty(globalThis.crypto, 'randomUUID', {
+    configurable: true,
+    value: () => 'e18d417a-2f0e-4aeb-a90d-32633ba52a33',
+  });
+});
+afterEach(() => {
+  client?.clear();
+});
+test('ordinary accounts never fetch admin data', () => {
+  mockRole = 'USER';
+  mount();
+  expect(screen.getByRole('alert')).toHaveTextContent('com_demo_admin_only');
+  expect(dataService.getDemoBudget).not.toHaveBeenCalled();
+  expect(dataService.getDemoAccounts).not.toHaveBeenCalled();
+});
+test('renders empty accounts and saves an explicit zero budget with the current revision', async () => {
+  const save = jest
+    .spyOn(dataService, 'updateDemoBudget')
+    .mockResolvedValue({ ...budget, limitCredits: 0, revision: 1 });
+  mount();
+  expect(await screen.findByText('com_demo_no_accounts')).toBeInTheDocument();
+  fireEvent.change(screen.getByLabelText('com_demo_new_limit'), { target: { value: '0' } });
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_save_limit' }));
+  await waitFor(() => expect(save).toHaveBeenCalledWith({ credits: 0, revision: 0 }));
+  expect(await screen.findByRole('status')).toHaveTextContent('com_demo_saved');
+});
+test('a failed load offers a working refresh', async () => {
+  jest.spyOn(dataService, 'getDemoBudget').mockRejectedValueOnce(new Error('network unavailable'));
+  mount();
+  expect(await screen.findByRole('alert')).toHaveTextContent('com_demo_failed');
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_refresh' }));
+  expect(await screen.findByText('com_demo_daily_budget')).toBeInTheDocument();
+});
+test('uncertain top-up retry keeps the same id and amount', async () => {
+  jest.spyOn(dataService, 'getDemoAccounts').mockResolvedValue({
+    users: [
+      {
+        id: 'account',
+        email: 'fixture@example.test',
+        name: 'Fixture',
+        role: 'USER',
+        credits: 100,
+      },
+    ],
+    total: 1,
+    page: 0,
+  });
+  const topup = jest
+    .spyOn(dataService, 'addDemoCredits')
+    .mockRejectedValueOnce(new Error('connection lost'))
+    .mockResolvedValueOnce({ outcome: 'duplicate' });
+  mount();
+  fireEvent.click(await screen.findByRole('button', { name: 'com_demo_add_credits' }));
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_confirm_topup' }));
+  expect(await screen.findByRole('alert')).toBeInTheDocument();
+  expect(screen.getByLabelText('com_demo_topup_for')).toBeDisabled();
+  fireEvent.click(screen.getByRole('button', { name: 'com_demo_confirm_topup' }));
+  await waitFor(() => expect(topup).toHaveBeenCalledTimes(2));
+  expect(topup.mock.calls[0]).toEqual(topup.mock.calls[1]);
+  expect(await screen.findByRole('status')).toHaveTextContent('com_demo_saved');
+});
