+++ b/packages/api/src/budget/fetch.ts
@@ -0,0 +1,249 @@
+import { z } from 'zod';
+import { randomUUID } from 'node:crypto';
+import type { SiteBudgetMethods } from '@librechat/data-schemas';
+import type { SiteBudgetConfig } from 'librechat-data-provider';
+
+const requestSchema = z
+  .object({
+    model: z.string().min(1),
+    messages: z
+      .array(
+        z
+          .object({
+            content: z
+              .union([
+                z.string(),
+                z.null(),
+                z.array(z.object({ type: z.literal('text'), text: z.string() }).strict()),
+              ])
+              .optional(),
+          })
+          .passthrough(),
+      )
+      .min(1),
+    tools: z.array(z.unknown()).optional(),
+    stream: z.boolean().optional(),
+    n: z.number().optional(),
+    max_tokens: z.number().int().positive().optional(),
+    max_completion_tokens: z.number().int().positive().optional(),
+    stream_options: z.record(z.string(), z.unknown()).optional(),
+  })
+  .passthrough();
+const usageSchema = z.object({
+  usage: z.object({
+    prompt_tokens: z.number().int().nonnegative(),
+    completion_tokens: z.number().int().nonnegative(),
+  }),
+});
+export type BudgetTransport = (
+  url: string | URL | Request,
+  init?: RequestInit,
+) => Promise<Response>;
+
+export interface BudgetRates {
+  prompt: number;
+  completion: number;
+}
+
+export function budgetDay(timeZone: string, now = new Date()): string {
+  return new Intl.DateTimeFormat('en-CA', {
+    timeZone,
+    year: 'numeric',
+    month: '2-digit',
+    day: '2-digit',
+  }).format(now);
+}
+
+function rejected(code: string, status: number): Response {
+  return Response.json(
+    {
+      error: {
+        code,
+        type: 'site_budget',
+        message:
+          code === 'site_budget_exceeded'
+            ? 'The daily demo budget is exhausted or reserved by active requests. Your personal credits are unchanged. Please try later.'
+            : code === 'site_budget_request_too_large'
+              ? 'The model request exceeds the demo request-size limit. Reduce the supplied content or start a new chat.'
+              : 'The demo budget could not admit this model request. Please try again later.',
+      },
+    },
+    { status },
+  );
+}
+
+/** Applied to the provider transport so each attempt, title and resumed tool loop
+ * uses the same gate. It is independent of user-credit admission/settlement. */
+export function createBudgetFetch(input: {
+  config: SiteBudgetConfig;
+  baseURL: string;
+  rates: Record<string, BudgetRates>;
+  db: Pick<SiteBudgetMethods, 'reserveSiteBudget' | 'settleSiteBudget'>;
+  transport?: BudgetTransport;
+  now?: () => Date;
+}): BudgetTransport {
+  const transport = input.transport ?? globalThis.fetch;
+  const origin = new URL(input.baseURL).origin;
+  return async (url, init) => {
+    let body;
+    try {
+      const target = new URL(url instanceof Request ? url.url : String(url));
+      if (
+        target.origin !== origin ||
+        !target.pathname.endsWith('/chat/completions') ||
+        init?.method?.toUpperCase() !== 'POST' ||
+        typeof init.body !== 'string'
+      )
+        return rejected('site_budget_request_unsupported', 400);
+      if (Buffer.byteLength(init.body) > input.config.maxRequestBytes)
+        return rejected('site_budget_request_too_large', 400);
+      body = requestSchema.parse(JSON.parse(init.body));
+      if (body.n != null && body.n !== 1) return rejected('site_budget_request_unsupported', 400);
+    } catch {
+      return rejected('site_budget_request_unsupported', 400);
+    }
+    const rate = input.rates[body.model];
+    if (
+      !rate ||
+      !Number.isFinite(rate.prompt) ||
+      !Number.isFinite(rate.completion) ||
+      rate.prompt <= 0 ||
+      rate.completion <= 0
+    )
+      return rejected('site_budget_unavailable', 503);
+    const outputLimit = Math.min(
+      body.max_tokens ?? body.max_completion_tokens ?? input.config.maxOutputTokens,
+      input.config.maxOutputTokens,
+    );
+    delete body.max_completion_tokens;
+    body.max_tokens = outputLimit;
+    body.n = 1;
+    if (body.stream) body.stream_options = { ...body.stream_options, include_usage: true };
+    const serialized = JSON.stringify(body);
+    if (Buffer.byteLength(serialized) > input.config.maxRequestBytes)
+      return rejected('site_budget_request_too_large', 400);
+    // Conservative text reservation includes JSON, tool schemas and chat framing.
+    // This bound prices the hold; it is not a tokenizer or a context-window limit.
+    // Agent context management handles the model window, including tool history.
+    // Accounting follows the configured credits tariff; it is not a cloud invoice.
+    const promptBound = Buffer.byteLength(serialized) * 2 + 1024 + body.messages.length * 64;
+    const reserved = Math.ceil(promptBound * rate.prompt + outputLimit * rate.completion);
+    const id = randomUUID();
+    const day = budgetDay(input.config.timeZone, input.now?.());
+    if (init?.signal?.aborted) throw new Error('site_budget_request_cancelled');
+    try {
+      const admitted = await input.db.reserveSiteBudget({
+        day,
+        id,
+        credits: reserved,
+        initialLimitCredits: input.config.dailyCredits,
+        timeZone: input.config.timeZone,
+      });
+      if (!admitted) return rejected('site_budget_exceeded', 402);
+    } catch {
+      return rejected('site_budget_unavailable', 503);
+    }
+    let actual: number | undefined;
+    let settlement: Promise<void> | undefined;
+    const settle = () =>
+      (settlement ??= input.db
+        .settleSiteBudget({ day, id, credits: actual ?? reserved, uncertain: actual == null })
+        .catch(() => {
+          // Failed settlement retains its durable hold. Never free uncertain costs.
+        }));
+    const capture = (data: unknown) => {
+      const parsed = usageSchema.safeParse(data);
+      if (parsed.success)
+        actual = Math.max(
+          actual ?? 0,
+          Math.ceil(
+            parsed.data.usage.prompt_tokens * rate.prompt +
+              parsed.data.usage.completion_tokens * rate.completion,
+          ),
+        );
+    };
+    let response;
+    try {
+      response = await transport(url, { ...init, body: serialized, redirect: 'error' });
+    } catch {
+      await settle();
+      throw new Error('site_budget_provider_unavailable');
+    }
+    if (!response.ok) {
+      if ([400, 401, 403, 404, 422, 429].includes(response.status)) actual = 0;
+      await settle();
+      return response;
+    }
+    if (!body.stream) {
+      try {
+        const text = await response.text();
+        try {
+          capture(JSON.parse(text));
+        } catch {
+          /* Unreadable usage retains the maximum. */
+        }
+        await settle();
+        return new Response(text, { status: response.status, headers: response.headers });
+      } catch {
+        await settle();
+        throw new Error('site_budget_provider_unavailable');
+      }
+    }
+    if (!response.body) {
+      await settle();
+      return response;
+    }
+    const reader = response.body.getReader();
+    const decoder = new TextDecoder();
+    let pending = '';
+    let parsing = true;
+    function inspect(chunk: Uint8Array, final = false) {
+      if (!parsing) return;
+      pending += decoder.decode(chunk, { stream: !final });
+      const lines = pending.split('\n');
+      pending = lines.pop() ?? '';
+      if (final && pending) {
+        lines.push(pending);
+        pending = '';
+      }
+      for (const line of lines) {
+        if (!line.startsWith('data:')) continue;
+        try {
+          capture(JSON.parse(line.slice(5).trim()));
+        } catch {
+          /* delta/DONE frames */
+        }
+      }
+      if (pending.length > 2 * 1024 * 1024) {
+        pending = '';
+        parsing = false;
+      }
+    }
+    const stream = new ReadableStream<Uint8Array>({
+      async pull(controller) {
+        try {
+          const chunk = await reader.read();
+          if (chunk.done) {
+            inspect(new Uint8Array(), true);
+            await settle();
+            controller.close();
+            return;
+          }
+          inspect(chunk.value);
+          controller.enqueue(chunk.value);
+        } catch {
+          await settle();
+          controller.error(new Error('site_budget_provider_unavailable'));
+        }
+      },
+      async cancel() {
+        try {
+          await reader.cancel();
+        } finally {
+          await settle();
+        }
+      },
+    });
+    return new Response(stream, { status: response.status, headers: response.headers });
+  };
+}
