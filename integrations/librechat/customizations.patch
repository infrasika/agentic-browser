+import { createUserModel } from '~/models/user';
+
+let server: MongoMemoryServer;
+const methods = createSiteBudgetMethods(mongoose);
+const admin = createDemoAdminMethods(mongoose);
+const User = createUserModel(mongoose);
+const Balance = createBalanceModel(mongoose);
+const policy = { day: '2026-10-24', initialLimitCredits: 100, timeZone: 'Asia/Shanghai' };
+beforeAll(async () => {
+  server = await MongoMemoryServer.create();
+  await mongoose.connect(server.getUri());
+});
+afterAll(async () => {
+  await mongoose.disconnect();
+  await server.stop();
+});
+beforeEach(async () => {
+  await mongoose.connection.dropDatabase();
+});
+
+test('parallel admissions never exceed the shared limit, including first-use initialization', async () => {
+  const results = await Promise.all(
+    Array.from({ length: 30 }, () =>
+      methods.reserveSiteBudget({ ...policy, id: randomUUID(), credits: 10 }),
+    ),
+  );
+  expect(results.filter(Boolean)).toHaveLength(10);
+  expect(await methods.getSiteBudget(policy)).toMatchObject({
+    spentCredits: 0,
+    reservedCredits: 100,
+    remainingCredits: 0,
+  });
+});
+test('settlement is idempotent under concurrency and releases only the unused reservation', async () => {
+  const id = randomUUID();
+  await methods.reserveSiteBudget({ ...policy, id, credits: 80 });
+  await Promise.all(
+    Array.from({ length: 10 }, () =>
+      methods.settleSiteBudget({ day: policy.day, id, credits: 30, uncertain: false }),
+    ),
+  );
+  expect(await methods.getSiteBudget(policy)).toMatchObject({
+    spentCredits: 30,
+    reservedCredits: 0,
+    remainingCredits: 70,
+  });
+});
+test('uncertain costs remain charged; crash holds survive a new methods instance', async () => {
+  const id = randomUUID();
+  await methods.reserveSiteBudget({ ...policy, id, credits: 40 });
+  await methods.settleSiteBudget({ day: policy.day, id, credits: 40, uncertain: true });
+  await methods.reserveSiteBudget({ ...policy, id: randomUUID(), credits: 60 });
+  expect(await createSiteBudgetMethods(mongoose).getSiteBudget(policy)).toMatchObject({
+    uncertainCredits: 40,
+    spentCredits: 40,
+    reservedCredits: 60,
+    remainingCredits: 0,
+  });
+});
+test('rollover preserves prior-day accounting and an administrator limit survives restarts', async () => {
+  const id = randomUUID();
+  await methods.reserveSiteBudget({ ...policy, id, credits: 80 });
+  expect(
+    await methods.setSiteBudgetLimit({ ...policy, credits: 150, revision: 0, actor: 'admin' }),
+  ).toBe(true);
+  expect(
+    await methods.setSiteBudgetLimit({ ...policy, credits: 999, revision: 0, actor: 'admin' }),
+  ).toBe(false);
+  expect(await methods.getSiteBudget({ ...policy, day: '2026-10-25' })).toMatchObject({
+    limitCredits: 150,
+    remainingCredits: 150,
+    revision: 1,
+  });
+  await methods.settleSiteBudget({ day: policy.day, id, credits: 20, uncertain: false });
+  expect(await methods.getSiteBudget(policy)).toMatchObject({
+    spentCredits: 20,
+    remainingCredits: 130,
+  });
+  await methods.setSiteBudgetLimit({ ...policy, credits: 0, revision: 1, actor: 'admin' });
+  expect(await methods.reserveSiteBudget({ ...policy, id: randomUUID(), credits: 1 })).toBe(false);
+});
+test.each([
+  { role: 'USER', self: false },
+  { role: 'ADMIN', self: false },
+  { role: 'ADMIN', self: true },
+])('admin top-up is idempotent and audited for $role (self=$self)', async ({ role, self }) => {
+  const user = await User.create({
+    email: 'fixture@example.test',
+    name: 'Fixture',
+    role,
+    provider: 'local',
+  });
+  await Balance.create({ user: user._id, tokenCredits: 200 });
+  const input = {
+    userId: String(user._id),
+    actor: self ? String(user._id) : String(new mongoose.Types.ObjectId()),
+    id: randomUUID(),
+    credits: 50,
+  };
+  const results = await Promise.all(
+    Array.from({ length: 12 }, () => admin.creditDemoAccount(input)),
+  );
+  expect(results.filter((value) => value === 'applied')).toHaveLength(1);
+  expect(results.filter((value) => value === 'duplicate')).toHaveLength(11);
+  expect(await Balance.findOne({ user: user._id }).lean()).toMatchObject({ tokenCredits: 250 });
+  expect((await Balance.findOne({ user: user._id }).lean())?.adminCredits).toBeUndefined();
+  const audit = await Balance.findOne({ user: user._id }).select('+adminCredits').lean();
+  expect(audit?.adminCredits).toHaveLength(1);
+  expect(audit?.adminCredits?.[0]).toMatchObject({ id: input.id, actor: input.actor, credits: 50 });
+  expect(await admin.creditDemoAccount({ ...input, credits: 51 })).toBe('missing');
+  const listed = await admin.listDemoAccounts(0);
+  expect(listed.users[0]).toEqual({
+    id: String(user._id),
+    name: 'Fixture',
+    email: 'fixture@example.test',
+    role,
+    credits: 250,
+  });
+  await User.updateOne({ _id: user._id }, { $set: { provider: 'google' } });
+  expect(await admin.creditDemoAccount({ ...input, id: randomUUID() })).toBe('missing');
+});
