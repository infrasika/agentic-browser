+import mongoose from 'mongoose';
+import { randomUUID } from 'node:crypto';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import { browserConfigSchema } from 'librechat-data-provider';
+import { Run, Providers, FakeChatModel } from '@librechat/agents';
+import { HumanMessage } from '@librechat/agents/langchain/messages';
+import type { BrowserWait, BrowserLease } from 'librechat-data-provider';
+import type { BrowserTransport } from './client';
+import {
+  getAgentCheckpointer,
+  __resetCheckpointerForTests,
+  LIBRECHAT_CHECKPOINT_NAMESPACE_KEY,
+} from '../agents/checkpointer';
+import { createBrowserTools, BROWSER_TOOL_NAMES } from './tools';
+import { browserPrincipal } from './identity';
+import { BrowserClient } from './client';
+
+jest.setTimeout(120000);
+test.each(['active', 'expired'] as const)(
+  'native handoff resumes from a fresh executor with lease state %s',
+  async (returnedState) => {
+    const mongo = await MongoMemoryServer.create();
+    await mongoose.connect(mongo.getUri());
+    try {
+      const conversationId = randomUUID();
+      const runId = randomUUID();
+      const principal = browserPrincipal('507f1f77bcf86cd799439011', conversationId, 1000);
+      const lease: BrowserLease = {
+        ...principal,
+        id: randomUUID(),
+        acquisitionId: 'pending',
+        purpose: 'Demo',
+        url: 'https://example.com',
+        state: 'queued',
+        sessionId: null,
+        createdAt: 1000,
+        updatedAt: 1000,
+        expiresAt: null,
+        revision: 0,
+        control: 'agent',
+        error: null,
+      };
+      const journal = new Map<string, unknown>();
+      const acquisitions: string[] = [];
+      let transfers = 0;
+      const transport: BrowserTransport = async (url, options) => {
+        const headers = new Headers(options?.headers);
+        expect(headers.get('x-user-id')).toBe(principal.userId);
+        expect(headers.get('x-task-id')).toBe(principal.taskId);
+        expect(headers.get('authorization')).toBe('Bearer service-token-for-native-test-0001');
+        const path = new URL(String(url)).pathname;
+        const body = options?.body ? JSON.parse(String(options.body)) : {};
+        if (path === '/internal/v1/leases') {
+          acquisitions.push(body.acquisitionId);
+          lease.acquisitionId = body.acquisitionId;
+          return Response.json(lease);
+        }
+        if (path.endsWith('/control')) {
+          if (!journal.has(body.operationId)) {
+            transfers++;
+            lease.control = 'human';
+            lease.revision++;
+            journal.set(body.operationId, {
+              leaseId: lease.id,
+              revision: lease.revision,
+              control: 'human',
+            });
+          }
+          return Response.json(journal.get(body.operationId));
+        }
+        if (path === `/internal/v1/leases/${lease.id}`) return Response.json(lease);
+        throw new Error('Unexpected request');
+      };
+      const client = new BrowserClient(
+        browserConfigSchema.parse({ enabled: true }),
+        'service-token-for-native-test-0001',
+        transport,
+      );
+      const config = {
+        runName: 'AgentRun',
+        configurable: {
+          thread_id: conversationId,
+          checkpoint_ns: '',
+          [LIBRECHAT_CHECKPOINT_NAMESPACE_KEY]: runId,
+          user_id: principal.userId,
+        },
+        streamMode: 'values' as const,
+        version: 'v2' as const,
+      };
+      const build = async (phase: 0 | 1 | 2) => {
+        const run = await Run.create({
+          runId,
+          graphConfig: {
+            type: 'standard',
+            agents: [
+              {
+                agentId: 'demo',
+                provider: Providers.OPENAI,
+                clientOptions: { model: 'test-model', streaming: true, streamUsage: false },
+                instructions: 'Use the browser.',
+                maxContextTokens: 8000,
+                toolDefinitions: [
+                  { name: 'event_tool', description: 'Exercise production event mode' },
+                ],
+                graphTools: createBrowserTools({
+                  client,
+                  principal,
+                  signal: new AbortController().signal,
+                  agentIds: ['demo'],
+                }),
+              },
+            ],
+            compileOptions: {
+              checkpointer: await getAgentCheckpointer({ type: 'mongo', ttl: 3600 }),
+            },
+          },
+          returnContent: true,
+          customHandlers: {},
+          tokenCounter: (message) => JSON.stringify(message.content).length,
+          indexTokenCountMap: {},
+          eagerEventToolExecution: { enabled: true, excludeToolNames: BROWSER_TOOL_NAMES },
+          interruptingToolNames: BROWSER_TOOL_NAMES,
+        });
+        if (!run.Graph) throw new Error('Missing graph');
+        run.Graph.overrideModel = new FakeChatModel({
+          responses: ['Browser task phase'],
+          toolCalls: [
+            [
+              {
+                id: 'open-1',
+                type: 'tool_call' as const,
+                name: 'browser_open',
+                args: { purpose: 'Demo', url: 'https://example.com' },
+              },
+            ],
+            [
+              {
+                id: 'handoff-1',
+                type: 'tool_call' as const,
+                name: 'browser_request_handoff',
+                args: { leaseId: lease.id, reason: 'Please confirm in the browser' },
+              },
+            ],
+            [],
+          ][phase],
+        });
+        return run;
+      };
+      const first = await build(0);
+      await first.processStream(
+        { messages: [new HumanMessage('Use browser and ask for confirmation')] },
+        config,
+      );
+      expect(first.getInterrupt<BrowserWait>()?.payload.reason).toBe('waiting_for_slot');
+      await __resetCheckpointerForTests();
+      lease.state = 'active';
+      lease.sessionId = randomUUID();
+      lease.expiresAt = Date.now() + 60000;
+      const second = await build(1);
+      await second.resume({ browserReady: true }, config);
+      expect(second.getInterrupt<BrowserWait>()?.payload.reason).toBe('waiting_for_human');
+      expect(transfers).toBe(1);
+      await __resetCheckpointerForTests();
+      lease.control = 'agent';
+      lease.state = returnedState;
+      lease.revision = 2;
+      const third = await build(2);
+      await third.resume({ browserReady: true }, config);
+      expect(third.getInterrupt()).toBeUndefined();
+      const handoff = third
+        .getRunMessages()
+        ?.find((message) => message.name === 'browser_request_handoff');
+      expect(typeof handoff?.content).toBe('string');
+      const output = JSON.parse(String(handoff?.content));
+      if (returnedState === 'active') {
+        expect(output).toMatchObject({
+          ok: true,
+          value: { event: 'control_returned', control: 'agent', revision: 2 },
+        });
+        expect(output.value.nextStep).toContain('continue the original task now');
+      } else {
+        expect(output).toEqual({ ok: false, error: { code: 'session_ended', status: 410 } });
+      }
+      expect(transfers).toBe(1);
+      expect(acquisitions).toHaveLength(2);
+      expect(new Set(acquisitions).size).toBe(1);
+    } finally {
+      await __resetCheckpointerForTests();
+      await mongoose.disconnect();
+      await mongo.stop();
+    }
+  },
+);
