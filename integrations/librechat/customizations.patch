+  }
+  const { fetcher, db } = setup(
+    jest.fn(
+      async () =>
+        new Response(
+          new ReadableStream({
+            start(controller) {
+              controller.enqueue(new TextEncoder().encode('data: {}\n'));
+            },
+          }),
+        ),
+    ),
