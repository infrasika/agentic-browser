+import { browserConfigSchema } from 'librechat-data-provider';
+import type { Response } from 'express';
+import type { CheckBalanceDeps } from '../middleware/checkBalance';
+import type { ServerRequest } from '../types/http';
+import { reserveBrowserResumeBalance } from './balance';
+
+function fixture(reserved: boolean) {
+  const deps: CheckBalanceDeps = {
+    balanceConfig: { enabled: true },
+    getMultiplier: () => 0.276,
+    reserveBalance: jest.fn().mockResolvedValue({ reserved, balance: reserved ? 200000 : 0 }),
+    renewBalanceReservation: jest.fn().mockResolvedValue(undefined),
+    releaseBalanceReservation: jest.fn().mockResolvedValue(undefined),
+    logViolation: jest.fn().mockResolvedValue(undefined),
+  };
+  const input = {
+    browser: browserConfigSchema.parse({ enabled: true, agentIds: ['demo'] }),
+    agentId: 'demo',
+    req: {} as ServerRequest,
+    res: {} as Response,
+    user: 'user',
+    model: 'qwen3.7-plus',
+    endpoint: 'Qwen',
+    maxContextTokens: 64000,
+  };
+  return { deps, input };
+}
+test('zero credits reject a resumed browser task before tools or model can run', async () => {
+  const { input, deps } = fixture(false);
+  await expect(reserveBrowserResumeBalance(input, deps)).rejects.toThrow('token_balance');
+  expect(deps.reserveBalance).toHaveBeenCalledWith(
+    expect.objectContaining({ user: 'user', amount: 17664 }),
+  );
+  expect(deps.logViolation).toHaveBeenCalledWith(
+    input.req,
+    input.res,
+    'token_balance',
+    expect.any(Object),
+    0,
+  );
+});
+test('resume holds and releases the existing atomic ledger reservation', async () => {
+  const { input, deps } = fixture(true);
+  const reservation = await reserveBrowserResumeBalance(input, deps);
+  expect(reservation).toBeDefined();
+  expect(deps.releaseBalanceReservation).not.toHaveBeenCalled();
+  await reservation!.release();
+  expect(deps.releaseBalanceReservation).toHaveBeenCalledTimes(1);
+});
+test('disabled or unrelated agents keep their original balance behavior', async () => {
+  const { input, deps } = fixture(false);
+  expect(await reserveBrowserResumeBalance({ ...input, agentId: 'other' }, deps)).toBeUndefined();
+  expect(deps.reserveBalance).not.toHaveBeenCalled();
+});
