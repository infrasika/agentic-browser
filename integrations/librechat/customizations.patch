+    messages: [{ role: 'user', content: 'hello' }],
+    stream,
+    max_tokens: 99999,
+  }),
+});
+const response = () =>
+  Response.json({ choices: [], usage: { prompt_tokens: 100, completion_tokens: 10 } });
+// Synthetic page observations, with no signed-in data. The wire request is well
+// below 256 KiB but the conservative reservation exceeds the old 64K gate.
+const snapshotRequest = (stream = false) => ({
+  method: 'POST',
+  body: JSON.stringify({
+    model: 'demo',
+    stream,
+    max_tokens: 99999,
+    tools: [
+      { type: 'function', function: { name: 'browser_snapshot', parameters: { type: 'object' } } },
+    ],
+    messages: [
+      { role: 'user', content: 'Read both repository pages and list their names.' },
+      ...[1, 2].flatMap((page) => [
+        {
+          role: 'assistant',
+          content: null,
+          tool_calls: [
+            {
+              id: `page-${page}`,
+              type: 'function',
+              function: { name: 'browser_snapshot', arguments: '{}' },
+            },
+          ],
+        },
+        {
+          role: 'tool',
+          tool_call_id: `page-${page}`,
+          content: JSON.stringify({
+            page,
+            text: `Repository ${page}: browser demo, description and navigation.\n`.repeat(400),
+          }),
+        },
+      ]),
+    ],
+  }),
+});
+function setup(transport: BudgetTransport = jest.fn(async () => response())) {
+  const db = {
+    reserveSiteBudget: jest.fn<
+      ReturnType<SiteBudgetMethods['reserveSiteBudget']>,
+      Parameters<SiteBudgetMethods['reserveSiteBudget']>
+    >(async () => true),
+    settleSiteBudget: jest.fn<
+      ReturnType<SiteBudgetMethods['settleSiteBudget']>,
+      Parameters<SiteBudgetMethods['settleSiteBudget']>
+    >(async () => {}),
+  };
+  const fetcher = createBudgetFetch({
+    config,
+    baseURL,
+    rates: { demo: { prompt: 0.276, completion: 1.101 } },
+    db,
+    transport,
+  });
+  return { db, transport, fetcher };
+}
+test('Shanghai rollover occurs at 16:00 UTC', () => {
+  expect(budgetDay('Asia/Shanghai', new Date('2026-10-24T15:59:59Z'))).toBe('2026-10-24');
+  expect(budgetDay('Asia/Shanghai', new Date('2026-10-24T16:00:00Z'))).toBe('2026-10-25');
+});
+test('a denied or unavailable ledger never contacts the model', async () => {
+  const { db, transport, fetcher } = setup();
+  db.reserveSiteBudget.mockResolvedValueOnce(false);
+  expect((await fetcher(url, request())).status).toBe(402);
+  db.reserveSiteBudget.mockRejectedValueOnce(new Error('secret database URI'));
+  const result = await fetcher(url, request());
+  expect(result.status).toBe(503);
+  expect(await result.text()).not.toContain('secret');
+  expect(transport).not.toHaveBeenCalled();
+});
+test('clamps output and accounts actual non-stream usage independently of personal credits', async () => {
+  const { db, transport, fetcher } = setup();
+  expect((await fetcher(url, request())).status).toBe(200);
+  const sent = JSON.parse((transport as jest.Mock).mock.calls[0][1].body);
+  expect(sent.max_tokens).toBe(4096);
+  expect(sent.n).toBe(1);
+  expect(db.settleSiteBudget).toHaveBeenCalledWith(
+    expect.objectContaining({ credits: 39, uncertain: false }),
+  );
+});
+test.each([false, true])(
+  'page snapshots continue without treating reserved cost as context length (stream=%s)',
+  async (stream) => {
+    const input = snapshotRequest(stream);
+    expect(Buffer.byteLength(input.body)).toBeGreaterThan(32000);
+    expect(Buffer.byteLength(input.body)).toBeLessThan(config.maxRequestBytes);
+    const { db, transport, fetcher } = setup(
+      jest.fn(async () =>
+        stream
+          ? new Response(
+              'data: {"choices":[],"usage":{"prompt_tokens":8000,"completion_tokens":40}}\n\ndata: [DONE]\n\n',
+            )
+          : Response.json({ choices: [], usage: { prompt_tokens: 8000, completion_tokens: 40 } }),
+      ),
+    );
+    const result = await fetcher(url, input);
+    expect(result.status).toBe(200);
+    await result.text();
+    const sent = JSON.parse((transport as jest.Mock).mock.calls[0][1].body);
+    expect(sent.messages).toEqual(JSON.parse(input.body).messages);
+    expect(sent.tools).toEqual(JSON.parse(input.body).tools);
+    expect(sent.max_tokens).toBe(4096);
+    // The full conservative hold still exceeds the former 64K reservation cap.
+    expect(db.reserveSiteBudget.mock.calls[0][0].credits).toBeGreaterThan(
+      64000 * 0.276 + 4096 * 1.101,
+    );
+    expect(db.settleSiteBudget).toHaveBeenCalledWith(
+      expect.objectContaining({ credits: 2253, uncertain: false }),
+    );
+  },
+);
+test('large page observations cannot bypass an exhausted daily budget', async () => {
+  const { db, transport, fetcher } = setup();
+  db.reserveSiteBudget.mockResolvedValueOnce(false);
+  const result = await fetcher(url, snapshotRequest());
+  expect(result.status).toBe(402);
+  expect((await result.json()).error.code).toBe('site_budget_exceeded');
+  expect(transport).not.toHaveBeenCalled();
+  expect(db.settleSiteBudget).not.toHaveBeenCalled();
+});
+test('request byte limit admits the boundary and rejects oversized UTF-8 before reserving or spending', async () => {
+  const body = { model: 'demo', messages: [{ role: 'user', content: '' }], max_tokens: 4096, n: 1 };
+  body.messages[0].content = 'a'.repeat(
+    config.maxRequestBytes - Buffer.byteLength(JSON.stringify(body)),
+  );
+  const input = { method: 'POST', body: JSON.stringify(body) };
+  expect(Buffer.byteLength(input.body)).toBe(config.maxRequestBytes);
+  expect((await setup().fetcher(url, input)).status).toBe(200);
+  body.messages[0].content = '界'.repeat(Math.ceil(config.maxRequestBytes / 3));
+  input.body = JSON.stringify(body);
+  expect(input.body.length).toBeLessThan(config.maxRequestBytes);
+  const { fetcher, db, transport } = setup();
+  const result = await fetcher(url, input);
+  expect(result.status).toBe(400);
+  expect((await result.json()).error.code).toBe('site_budget_request_too_large');
+  expect(db.reserveSiteBudget).not.toHaveBeenCalled();
+  expect(transport).not.toHaveBeenCalled();
+});
+test('normalizing stream usage cannot grow the outbound body past the byte limit', async () => {
+  const body = { model: 'demo', messages: [{ content: '' }], max_tokens: 4096, n: 1, stream: true };
+  body.messages[0].content = 'a'.repeat(
+    config.maxRequestBytes - Buffer.byteLength(JSON.stringify(body)),
+  );
+  const input = { method: 'POST', body: JSON.stringify(body) };
+  expect(Buffer.byteLength(input.body)).toBe(config.maxRequestBytes);
+  const { fetcher, db, transport } = setup();
+  const result = await fetcher(url, input);
+  expect((await result.json()).error.code).toBe('site_budget_request_too_large');
+  expect(db.reserveSiteBudget).not.toHaveBeenCalled();
