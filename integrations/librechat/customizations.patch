+import express from 'express';
+import request from 'supertest';
+import { siteBudgetSchema } from 'librechat-data-provider';
+import type { RequestHandler } from 'express';
+import type { ServerRequest } from '~/types/http';
+import { createSameOriginGuard } from '~/middleware/origin';
+import { createDemoAdminRouter } from './admin';
+
+const budget = {
+  day: '2026-10-24',
+  timeZone: 'Asia/Shanghai',
+  limitCredits: 20000000,
+  spentCredits: 10,
+  reservedCredits: 0,
+  uncertainCredits: 0,
+  remainingCredits: 19999990,
+  revision: 0,
+};
+function app(role = 'ADMIN', tenantId?: string, enabled = true) {
+  const deps = {
+    getSiteBudget: jest.fn(async () => budget),
+    reserveSiteBudget: jest.fn(async () => true),
+    settleSiteBudget: jest.fn(async () => {}),
+    setSiteBudgetLimit: jest.fn(async () => true),
+    listDemoAccounts: jest.fn(async () => ({ users: [], total: 0, page: 0 })),
+    creditDemoAccount: jest.fn(async (): Promise<'applied' | 'duplicate' | 'missing'> => 'applied'),
+  };
+  const server = express();
+  server.use(express.json());
+  server.use(((req: ServerRequest, _res, next) => {
+    req.user = { id: 'admin-fixture', role, tenantId } as ServerRequest['user'];
+    req.config = {
+      balance: { siteBudget: siteBudgetSchema.parse({ enabled }) },
+    } as ServerRequest['config'];
+    next();
+  }) as RequestHandler);
+  server.use(
+    createSameOriginGuard({ trustedOrigins: ['https://demo.example.test'] }),
+    createDemoAdminRouter(deps),
+  );
+  return { server, deps };
+}
+test('ordinary accounts, tenant administrators, and disabled deployments cannot access administration', async () => {
+  for (const fixture of [app('USER'), app('ADMIN', 'tenant'), app('ADMIN', undefined, false)]) {
+    expect([403, 404]).toContain((await request(fixture.server).get('/users')).status);
+    expect(fixture.deps.listDemoAccounts).not.toHaveBeenCalled();
+    expect([403, 404]).toContain(
+      (await request(fixture.server).post('/budget').send({ credits: 0, revision: 0 })).status,
+    );
+    expect(fixture.deps.setSiteBudgetLimit).not.toHaveBeenCalled();
+  }
+});
+test('same-origin admin can read state and optimistic conflicts require a refresh', async () => {
+  const { server, deps } = app();
+  const state = await request(server).get('/');
+  expect(state.status).toBe(200);
+  expect(state.headers['cache-control']).toBe('no-store');
+  expect(state.body).toEqual(budget);
+  deps.setSiteBudgetLimit.mockResolvedValueOnce(false);
+  expect((await request(server).post('/budget').send({ credits: 0, revision: 0 })).status).toBe(
+    409,
+  );
+  expect(
+    (
+      await request(server)
+        .post('/budget')
+        .set('Origin', 'https://evil.example')
+        .send({ credits: 0, revision: 0 })
+    ).status,
+  ).toBe(403);
+  expect(deps.setSiteBudgetLimit).toHaveBeenCalledTimes(1);
+});
+test('invalid mutations are rejected and operational errors never leak diagnostics', async () => {
+  const { server, deps } = app();
+  expect((await request(server).post('/budget').send({ credits: -1, revision: 0 })).status).toBe(
+    400,
+  );
+  expect(
+    (await request(server).post('/users/invalid/credits').send({ credits: 10, id: 'not-an-id' }))
+      .status,
+  ).toBe(400);
+  expect(deps.creditDemoAccount).not.toHaveBeenCalled();
+  deps.getSiteBudget.mockRejectedValueOnce(new Error('mongodb://private-secret'));
+  const response = await request(server).get('/');
+  expect(response.status).toBe(503);
+  expect(response.text).not.toContain('private-secret');
+});
