+++ b/packages/api/src/browser/http.spec.ts
@@ -0,0 +1,99 @@
+import express from 'express';
+import request from 'supertest';
+import type { RequestHandler } from 'express';
+import type { BrowserIntegration } from './runtime';
+import { createBrowserRouter, createBrowserResumeIngress, revokeBrowserOnLogout } from './http';
+
+const conversationId = '11111111-1111-4111-8111-111111111111';
+function fixture() {
+  const app = express();
+  app.use(express.json());
+  const principal = { userId: 'trusted-user', conversationId, taskId: 'trusted-task' };
+  const current = jest
+    .fn<Promise<unknown>, unknown[]>()
+    .mockResolvedValue({ ok: true, value: { principal, lease: { id: 'lease-1', revision: 2 } } });
+  const integration = {
+    current,
+    revokeUser: jest.fn().mockResolvedValue(undefined),
+    isInternalResume: jest.fn().mockResolvedValue(false),
+    client: {
+      grant: jest.fn().mockResolvedValue({ ok: true, value: { grant: 'one-use' } }),
+      command: jest.fn(),
+      release: jest.fn(),
+      revokeUser: jest.fn().mockResolvedValue({ ok: true, value: { revoked: true } }),
+    },
+  };
+  app.locals.browser = integration;
+  app.use((req, _res, next) => {
+    req.user = { id: 'trusted-user' };
+    next();
+  });
+  app.use('/browser', createBrowserRouter(integration as unknown as BrowserIntegration));
+  const ua = jest.fn<ReturnType<RequestHandler>, Parameters<RequestHandler>>((_req, res) => {
+    res.status(400).json({ error: 'browser_required' });
+  });
+  app.post('/logout', revokeBrowserOnLogout, (_req, res) => {
+    res.json({ loggedOut: true });
+  });
+  app.use(createBrowserResumeIngress(ua));
+  app.post('/chat/resume', (_req, res) => {
+    res.json({ accepted: true });
+  });
+  return { app, integration, principal, ua };
+}
+test('BFF derives identity from authenticated user and generation, ignoring forged headers', async () => {
+  const f = fixture();
+  await request(f.app)
+    .post(`/browser/${conversationId}/viewer`)
+    .set('X-User-ID', 'victim')
+    .send({ revision: 2, role: 'observe' })
+    .expect(200);
+  expect(f.integration.current).toHaveBeenCalledWith('trusted-user', conversationId, undefined);
+  expect(f.integration.client.grant).toHaveBeenCalledWith('lease-1', f.principal, 2, 'observe');
+  await request(f.app)
+    .post(`/browser/${conversationId}/viewer`)
+    .send({ revision: 2, role: 'observe', userId: 'victim' })
+    .expect(400);
+});
+test('cross-user and missing jobs disclose no lease and never issue grants', async () => {
+  const f = fixture();
+  f.integration.current.mockResolvedValue(null);
+  const r = await request(f.app).get(`/browser/${conversationId}`).expect(200);
+  expect(r.body).toEqual({ lease: null });
+  await request(f.app)
+    .post(`/browser/${conversationId}/viewer`)
+    .send({ revision: 2, role: 'observe' })
+    .expect(404);
+  expect(f.integration.client.grant).not.toHaveBeenCalled();
+});
+test('only verified loopback recovery can pass browser-only ingress', async () => {
+  const f = fixture();
+  await request(f.app).post('/chat/resume').send({ conversationId, browserProof: {} }).expect(400);
+  f.integration.isInternalResume.mockResolvedValue(true);
+  await request(f.app)
+    .post('/chat/resume')
+    .send({ conversationId, actionId: 'action', browserProof: 'proof' })
+    .expect(200);
+  expect(f.integration.isInternalResume).toHaveBeenLastCalledWith({
+    userId: 'trusted-user',
+    tenantId: undefined,
+    conversationId,
+    actionId: 'action',
+    proof: 'proof',
+  });
+  await request(f.app)
+    .post('/chat/resume')
+    .set('Origin', 'https://public.example')
+    .send({})
+    .expect(400);
+  await request(f.app).post('/chat/other').send({}).expect(400);
+});
+
+test('logout revokes viewers using authenticated identity, and does not claim success during an outage', async () => {
+  const f = fixture();
+  await request(f.app).post('/logout').set('X-User-ID', 'victim').send({}).expect(200);
+  expect(f.integration.revokeUser).toHaveBeenCalledWith('trusted-user', undefined);
+  f.integration.revokeUser.mockRejectedValue(new Error('private-service-details'));
+  const result = await request(f.app).post('/logout').send({}).expect(503);
+  expect(result.body).toEqual({ error: 'browser_unavailable' });
+});
diff --git a/packages/api/src/browser/http.ts b/packages/api/src/browser/http.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1c6db281c53d81f5733f249931123e6915969729
--- /dev/null
+++ b/packages/api/src/browser/http.ts
@@ -0,0 +1,154 @@
+import { z } from 'zod';
+import { Router } from 'express';
+import type { RequestHandler } from 'express';
+import type { BrowserIntegration } from './runtime';
+
+const verifiedBrowserResume: unique symbol = Symbol('verifiedBrowserResume');
+type BrowserResumeRequest = Parameters<RequestHandler>[0] & { [verifiedBrowserResume]?: boolean };
+export const isVerifiedBrowserResume = (req: BrowserResumeRequest): boolean =>
+  req[verifiedBrowserResume] === true;
+
+/** Mounted behind normal LibreChat JWT, configuration and account-ban middleware. */
+export function createBrowserRouter(integration?: BrowserIntegration): ReturnType<typeof Router> {
+  const router = Router();
+  router.use((_req, res, next) => {
+    res.set('Cache-Control', 'no-store');
+    if (!integration) {
+      res.status(404).json({ error: 'browser_disabled' });
+      return;
+    }
+    next();
+  });
+  router.all(['/:conversationId', '/:conversationId/:operation'], async (req, res) => {
+    try {
+      const id = z.string().uuid().safeParse(req.params.conversationId);
+      const user = z
+        .object({ id: z.string(), tenantId: z.string().optional() })
+        .safeParse(req.user);
+      if (!id.success || !user.success || !integration) {
+        res.status(404).json({ error: 'not_found' });
+        return;
+      }
+      const current = await integration.current(user.data.id, id.data, user.data.tenantId);
+      if (!current) {
+        if (!req.params.operation && req.method === 'GET') {
+          res.json({ lease: null });
+          return;
+        }
+        res.status(404).json({ error: 'not_found' });
+        return;
+      }
+      if (!current.ok) {
+        res.status(current.error.status).json({ error: current.error.code });
+        return;
+      }
+      const { principal, lease } = current.value;
+      if (!req.params.operation && req.method === 'GET') {
+        res.json({ lease });
+        return;
+      }
+      if (!lease) {
+        res.status(404).json({ error: 'not_found' });
+        return;
+      }
+      if (req.method !== 'POST') {
+        res.status(405).json({ error: 'method_not_allowed' });
+        return;
+      }
+      let result;
+      if (req.params.operation === 'viewer') {
+        const input = z
+          .object({ revision: z.number().int().nonnegative(), role: z.enum(['observe', 'input']) })
+          .strict()
+          .parse(req.body);
+        result = await integration.client.grant(lease.id, principal, input.revision, input.role);
+      } else if (req.params.operation === 'control') {
+        const input = z
+          .object({
+            revision: z.number().int().nonnegative(),
+            target: z.enum(['agent', 'human']),
+            operationId: z.string().uuid(),
+          })
+          .strict()
+          .parse(req.body);
+        result = await integration.client.command(
+          lease.id,
+          'control',
+          principal,
+          { ...input, reason: 'User changed control from the browser panel' },
+          undefined,
+          'human',
+        );
+      } else if (req.params.operation === 'cancel') {
+        z.object({}).strict().parse(req.body);
+        result = await integration.client.release(lease.id, principal);
+      } else {
+        res.status(404).json({ error: 'not_found' });
+        return;
+      }
+      if (!result.ok) {
+        res.status(result.error.status).json({ error: result.error.code });
+        return;
+      }
+      res.json(result.value);
+    } catch (error) {
+      res
+        .status(error instanceof z.ZodError ? 400 : 503)
+        .json({ error: error instanceof z.ZodError ? 'invalid_request' : 'browser_unavailable' });
+    }
+  });
+  return router;
+}
+
+/** Only a signed event on the authenticated loopback resume route skips the browser-only UA check. */
+export function createBrowserResumeIngress(fallback: RequestHandler): RequestHandler {
+  return async (req, res, next) => {
+    const user = req.user as { id?: string; tenantId?: string } | undefined;
+    const integration = req.app.locals.browser as BrowserIntegration | undefined;
+    const address = req.socket.remoteAddress;
+    if (
+      req.method === 'POST' &&
+      req.path === '/chat/resume' &&
+      !req.headers.origin &&
+      ['127.0.0.1', '::1', '::ffff:127.0.0.1'].includes(address ?? '') &&
+      user?.id &&
+      integration
+    ) {
+      try {
+        if (
+          await integration.isInternalResume({
+            userId: user.id,
+            tenantId: user.tenantId,
+            conversationId: req.body?.conversationId,
+            actionId: req.body?.actionId,
+            proof: req.body?.browserProof,
+          })
+        ) {
+          (req as BrowserResumeRequest)[verifiedBrowserResume] = true;
+          next();
+          return;
+        }
+      } catch {
+        res.status(503).json({ error: 'browser_unavailable' });
+        return;
+      }
+    }
+    return fallback(req, res, next);
+  };
+}
+
+/** Revoke active viewers and leases before completing an authenticated logout. */
+export const revokeBrowserOnLogout: RequestHandler = async (req, res, next) => {
+  const integration = req.app.locals.browser as BrowserIntegration | undefined;
+  const user = req.user as { id?: string; tenantId?: string } | undefined;
+  if (!integration || !user?.id) {
+    next();
+    return;
+  }
+  try {
+    await integration.revokeUser(user.id, user.tenantId);
+    next();
+  } catch {
+    res.status(503).json({ error: 'browser_unavailable' });
+  }
+};
