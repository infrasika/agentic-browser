@@ -0,0 +1,119 @@
+import { z } from 'zod';
+import mongoose from 'mongoose';
+import { randomUUID } from 'node:crypto';
+import { tool } from '@librechat/agents/langchain/tools';
+import { MongoMemoryServer } from 'mongodb-memory-server';
+import { Run, Providers, FakeChatModel } from '@librechat/agents';
+import { HumanMessage } from '@librechat/agents/langchain/messages';
+import type { BrowserWait } from './wait';
+import {
+  getAgentCheckpointer,
+  __resetCheckpointerForTests,
+  LIBRECHAT_CHECKPOINT_NAMESPACE_KEY,
+} from '../agents/checkpointer';
+import { isBrowserWait, waitForBrowser } from './wait';
+
+jest.setTimeout(120000);
+
+describe('browser graph interrupt with the real LibreChat Run and durable checkpoint', () => {
+  let mongo: MongoMemoryServer;
+  beforeAll(async () => {
+    mongo = await MongoMemoryServer.create();
+    await mongoose.connect(mongo.getUri());
+  });
+  afterAll(async () => {
+    await __resetCheckpointerForTests();
+    await mongoose.disconnect();
+    await mongo.stop();
+  });
+
+  test('a fresh executor resumes a custom browser wait without requesting user chat input', async () => {
+    const leaseId = randomUUID();
+    const conversationId = randomUUID();
+    const runId = randomUUID();
+    const input = {
+      type: 'browser_wait' as const,
+      reason: 'waiting_for_human' as const,
+      leaseId,
+      tool_call_id: 'handoff-1',
+      revision: 1,
+    };
+    let bodyEntries = 0;
+    const executed = new Set<string>();
+    let liveControl = 'human';
+    const handoff = tool(
+      async () => {
+        bodyEntries++;
+        // Represents the external Browser API's durable idempotency contract.
+        executed.add('handoff-1');
+        waitForBrowser(input);
+        if (liveControl !== 'agent') throw new Error('Control was not returned');
+        return 'Browser control returned. Continue the task.';
+      },
+      {
+        name: 'browser_request_handoff',
+        description: 'Wait for browser control.',
+        schema: z.object({}),
+      },
+    );
+    const config = {
+      runName: 'AgentRun',
+      configurable: {
+        thread_id: conversationId,
+        checkpoint_ns: '',
+        [LIBRECHAT_CHECKPOINT_NAMESPACE_KEY]: runId,
+        user_id: 'browser-test-user',
+      },
+      streamMode: 'values' as const,
+      version: 'v2' as const,
+    };
+    const build = async (first: boolean) => {
+      const saver = await getAgentCheckpointer({ type: 'mongo', ttl: 3600 });
+      const run = await Run.create({
+        runId,
+        graphConfig: {
+          type: 'standard',
+          agents: [
+            {
+              agentId: 'browser-demo',
+              provider: Providers.OPENAI,
+              clientOptions: { model: 'test-model', streaming: true, streamUsage: false },
+              instructions: 'Test browser waiting.',
+              maxContextTokens: 8000,
+              toolDefinitions: [{ name: 'event_tool', description: 'Event transport test' }],
+              graphTools: [handoff],
+            },
+          ],
+          compileOptions: { checkpointer: saver },
+        },
+        returnContent: true,
+        customHandlers: {},
+        tokenCounter: (message) => JSON.stringify(message.content).length,
+        indexTokenCountMap: {},
+        eagerEventToolExecution: { enabled: true, excludeToolNames: ['browser_request_handoff'] },
+        interruptingToolNames: ['browser_request_handoff'],
+      });
+      if (!run.Graph) throw new Error('Graph was not constructed');
+      run.Graph.overrideModel = new FakeChatModel({
+        responses: first ? ['Opening the browser.'] : ['Task resumed'],
+        toolCalls: first
+          ? [{ id: 'handoff-1', name: 'browser_request_handoff', args: {}, type: 'tool_call' }]
+          : [],
+      });
+      return run;
+    };
+    const initial = await build(true);
+    await initial.processStream({ messages: [new HumanMessage('Use the browser')] }, config);
+    const pending = initial.getInterrupt<BrowserWait>();
+    expect(isBrowserWait(pending?.payload)).toBe(true);
+    expect(pending?.payload).toMatchObject(input);
+    expect(bodyEntries).toBe(1);
+    await __resetCheckpointerForTests();
+    liveControl = 'agent';
+    const resumed = await build(false);
+    await resumed.resume({ event: 'control_returned' }, config);
+    expect(resumed.getInterrupt()).toBeUndefined();
+    expect(bodyEntries).toBe(2);
+    expect(executed.size).toBe(1);
+  });
+});
diff --git a/packages/api/src/browser/wait.ts b/packages/api/src/browser/wait.ts
