# Private image deployment: copy to .env.compose and edit before starting.
# The helper passes these settings into the controller at startup.
# After edits, finish sessions and run:
# bash scripts/release-compose.sh up -d --force-recreate --wait
# A plain restart does not apply changes. No image rebuild is needed.

# Keep the project name stable: it selects this installation's private volume.
AB_PROJECT_NAME=agentic-browser
AB_PORT=3333
# Leave commented to derive http://127.0.0.1:<AB_PORT>, or set your HTTPS origin.
# AB_PUBLIC_URL=https://browser.example.com

# Total browsers and per-member limit (1-32 each; the total limit also applies).
AB_MAX_SESSIONS=1
AB_MAX_SESSIONS_PER_MEMBER=1
# Initial lease (60-14400 seconds); renewals cannot exceed the maximum lifetime.
AB_SESSION_TTL_SECONDS=1800
# Maximum lifetime (60-86400 seconds); keep it at least as long as the lease.
AB_SESSION_MAX_LIFETIME_SECONDS=14400

# Optional extra hostnames browsers must not visit, separated by commas.
# AB_EGRESS_DENY_HOSTS=other-management.example.com
# Native architecture is selected automatically; override only for testing.
# AB_RUNTIME_PLATFORM=auto

# Image digests come from deploy/release.env, not this file.
# Members are created with the member helper; Agent credentials come from the
# dashboard. Do not put passwords or personal Agent credentials here.
