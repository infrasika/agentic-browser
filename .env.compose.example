# Optional local settings: copy to .env.compose. Never put passwords here.
# Keep the project name stable: it selects this installation's private volume.
AB_PROJECT_NAME=agentic-browser
AB_PORT=3333
AB_MAX_SESSIONS=1
# AB_PUBLIC_URL=http://127.0.0.1:3333
# AB_EGRESS_DENY_HOSTS=other-management.example.com
# Source builds: scripts/build-container-images.sh (native amd64 or arm64).
# Published images: scripts/release-compose.sh and deploy/release.env pins.
# AB_CONTROLLER_IMAGE=agentic-browser:controller-preview
# AB_RUNTIME_IMAGE=agentic-browser:zkpass-prototype
# Only for explicitly testing an older amd64 image on an ARM host:
# AB_RUNTIME_PLATFORM=linux/amd64
